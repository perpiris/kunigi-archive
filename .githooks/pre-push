#!/bin/sh
# Blocks direct pushes to master. Work on a branch, open a PR, squash-merge.
# Enable once per clone:  git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    echo "pre-push: direct pushes to master are blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
