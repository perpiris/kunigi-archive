{
  "ConnectionStrings": {
    "KunigiArchive": ""
  },
  "MediaStorage": {
    "RootPath": "/app/media"
  },
  "EmailSettings": {
    "Host": "live.smtp.mailtrap.io",
    "Port": 587,
    "Username": "api",
    "Password": "",
    "EnableSsl": true,
    "SenderEmail": "hello@tokinigi.gr",
    "SenderName": "Το Κυνήγι",
    "ApplicationUrl": "https://tokinigi.gr"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
