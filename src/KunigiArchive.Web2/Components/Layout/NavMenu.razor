@* The masthead: mark and name, the public sections, then the signed-in user's area and the theme switch. *@
<header class="masthead">
    <div class="k-wrap masthead-row">
        <a class="brand" href="">
            <BrandMark />
            <span>
                <strong>Το Κυνήγι Θησαυρού</strong>
                <small>Αρχείο · Ρέθυμνο</small>
            </span>
        </a>

        <nav class="sections" aria-label="Ενότητες">
            <NavLink href="teams">Ομάδες</NavLink>
            @* Each user has exactly one role, so at most one of these shows. *@
            <AuthorizeView Roles="@Roles.Admin">
                <NavLink href="admin">Διαχείριση</NavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Manager">
                <NavLink href="my-teams">Οι ομάδες μου</NavLink>
            </AuthorizeView>
        </nav>

        <div class="account">
            <AuthorizeView>
                <Authorized>
                    <span class="who" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                    <form action="auth/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="account-button">Αποσύνδεση</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="account-button" href="auth/login">Σύνδεση</a>
                </NotAuthorized>
            </AuthorizeView>
            <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false"
                    aria-label="Σκοτεινό θέμα" title="Σκοτεινό θέμα">
                <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
            </button>
        </div>
    </div>
</header>
