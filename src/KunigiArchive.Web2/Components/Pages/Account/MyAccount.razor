@page "/account"
@attribute [Authorize]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Users
@using KunigiArchive.Application.Users.MyAccount
@using KunigiArchive.Infrastructure.Identity
@using KunigiArchive.Web2.Forms.Account
@using Microsoft.AspNetCore.Identity
@inject GetMyAccountHandler GetMyAccountHandler
@inject ChangeMyEmailHandler ChangeMyEmailHandler
@inject ChangeMyPasswordHandler ChangeMyPasswordHandler
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inherits FormPage

<PageTitle>Ο λογαριασμός μου</PageTitle>

<div class="k-form-page">

@if (_account is not null)
{
    <header class="k-page-head">
        <h1>Ο λογαριασμός μου</h1>
    </header>

    @* MustChangePasswordMiddleware keeps the user on this page until the temporary password is replaced (#24). *@
    @if (HttpContext.User.HasClaim(c => c.Type == AppClaims.MustChangePassword))
    {
        <div class="alert alert-warning k-form-alert" role="alert">
            Συνδεθήκατε με προσωρινό κωδικό. Ορίστε παρακάτω τον δικό σας κωδικό για να συνεχίσετε.
        </div>
    }

    @if (_emailError is not null)
    {
        <div class="alert alert-danger k-form-alert" role="alert">@_emailError</div>
    }

    <EditForm Model="EmailForm" FormName="change-email" OnValidSubmit="ChangeEmailAsync" Enhance class="k-form">
        <DataAnnotationsValidator />
        <h2 class="k-form-title">Αλλαγή email</h2>
        <p class="form-text mt-0">Με αυτό το email συνδέεστε και σε αυτό έρχονται οι επαναφορές κωδικού.</p>

        <div class="k-field">
            <label for="new-email" class="form-label">Νέο email</label>
            <InputText id="new-email" type="email" autocomplete="email" class="form-control" @bind-Value="EmailForm.NewEmail" />
            <ValidationMessage For="() => EmailForm.NewEmail" />
        </div>

        <div class="k-field mb-0">
            <label for="email-password" class="form-label">Τωρινός κωδικός</label>
            <InputText id="email-password" type="password" autocomplete="current-password" class="form-control" @bind-Value="EmailForm.CurrentPassword" />
            <ValidationMessage For="() => EmailForm.CurrentPassword" />
        </div>

        <div class="k-form-actions">
            <button type="submit" class="btn btn-primary">Αλλαγή email</button>
        </div>
    </EditForm>

    @if (_passwordError is not null)
    {
        <div class="alert alert-danger k-form-alert" role="alert">@_passwordError</div>
    }

    <EditForm Model="PasswordForm" FormName="change-password" OnValidSubmit="ChangePasswordAsync" Enhance class="k-form">
        <DataAnnotationsValidator />
        <h2 class="k-form-title">Αλλαγή κωδικού</h2>
        <p class="form-text mt-0">@PasswordRules.Message Οι άλλες συνδέσεις σας (άλλες συσκευές) τερματίζονται.</p>

        @* Lets password managers save the new password under the right account. *@
        <input type="email" autocomplete="username" value="@_account.Email" readonly hidden />

        <div class="k-field">
            <label for="current-password" class="form-label">Τωρινός κωδικός</label>
            <InputText id="current-password" type="password" autocomplete="current-password" class="form-control" @bind-Value="PasswordForm.CurrentPassword" />
            <ValidationMessage For="() => PasswordForm.CurrentPassword" />
        </div>

        <div class="k-field">
            <label for="new-password" class="form-label">Νέος κωδικός</label>
            <InputText id="new-password" type="password" autocomplete="new-password" class="form-control" @bind-Value="PasswordForm.NewPassword" />
            <ValidationMessage For="() => PasswordForm.NewPassword" />
        </div>

        <div class="k-field mb-0">
            <label for="confirm-password" class="form-label">Επιβεβαίωση νέου κωδικού</label>
            <InputText id="confirm-password" type="password" autocomplete="new-password" class="form-control" @bind-Value="PasswordForm.ConfirmPassword" />
            <ValidationMessage For="() => PasswordForm.ConfirmPassword" />
        </div>

        <div class="k-form-actions">
            <button type="submit" class="btn btn-primary">Αλλαγή κωδικού</button>
        </div>
    </EditForm>
}

</div>

@code {
    [SupplyParameterFromForm(FormName = "change-email")]
    private ChangeEmailForm EmailForm { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordForm PasswordForm { get; set; } = null!;

    private UserAccount? _account;
    private string? _emailError;
    private string? _passwordError;

    protected override async Task OnInitializedAsync()
    {
        EmailForm ??= new ChangeEmailForm();
        PasswordForm ??= new ChangePasswordForm();

        _account = await GetMyAccountHandler.HandleAsync(CancellationToken.None);
    }

    private async Task ChangeEmailAsync()
    {
        try
        {
            await ChangeMyEmailHandler.HandleAsync(
                new ChangeMyEmailCommand(EmailForm.CurrentPassword, EmailForm.NewEmail), CancellationToken.None);
        }
        catch (Exception exception) when (exception is InvalidRequestException or ConflictException)
        {
            _emailError = exception.Message;
            return;
        }

        await RefreshSignInAsync();
        Reload("Το email άλλαξε. Από εδώ και πέρα συνδέεστε με το νέο email.");
    }

    private async Task ChangePasswordAsync()
    {
        try
        {
            await ChangeMyPasswordHandler.HandleAsync(
                new ChangeMyPasswordCommand(PasswordForm.CurrentPassword, PasswordForm.NewPassword), CancellationToken.None);
        }
        catch (InvalidRequestException exception)
        {
            _passwordError = exception.Message;
            return;
        }

        await RefreshSignInAsync();
        Reload("Ο κωδικός άλλαξε.");
    }

    // The change renewed the security stamp, which signs every session out; this one is signed in again
    // with the new stamp (and the new email as its name).
    private async Task RefreshSignInAsync()
    {
        AppUser? user = await UserManager.FindByIdAsync(_account!.Id.ToString());
        if (user is not null)
        {
            await SignInManager.RefreshSignInAsync(user);
        }
    }
}
