@page "/games/{Slug}"
@using KunigiArchive.Application.GameDays
@using KunigiArchive.Application.GameDays.GetGameDays
@using KunigiArchive.Application.Games
@using KunigiArchive.Application.Games.GetGameBySlug
@using KunigiArchive.Application.Posts
@using KunigiArchive.Application.Posts.GetGamePosts
@inject GetGameBySlugHandler GetGameBySlugHandler
@inject GetGamePostsHandler GetGamePostsHandler
@inject GetGameDaysHandler GetGameDaysHandler
@inject FindSlugRedirectHandler FindSlugRedirectHandler
@using KunigiArchive.Application.Common
@inject NavigationManager Navigation

@if (_game is not null)
{
    <PageTitle>@(_game.Title is null ? _game.OrderTitle : $"{_game.OrderTitle} «{_game.Title}»")</PageTitle>

    <section class="record">
        <div class="poster">
            <GamePoster Image="@_game.Image" Name="@_game.OrderTitle" Lazy="false" />
        </div>
        <div>
            <div class="year">@_game.Year</div>
            <h1><GameName Order="_game.Order" Year="_game.Year" /></h1>
            @if (_game.Title is not null)
            {
                <p class="subtitle">«@_game.Title»</p>
            }
            <dl class="facts">
                <dt>Διοργάνωση</dt>
                <dd><TeamLink Team="_game.Host" /></dd>
                <dt>Νικητής</dt>
                <dd><TeamLink Team="_game.Winner" /></dd>
            </dl>
            @if (_game.Note is not null)
            {
                <p class="note">@_game.Note</p>
            }
        </div>
    </section>

    @if (_game.Description is not null)
    {
        <section class="block">
            <h2>Το παιχνίδι</h2>
            <RichText Html="@_game.Description" Class="story" />
        </section>
    }

    @if (_days.Count > 0)
    {
        <section class="block">
            <h2>Ημέρες</h2>
            <ul class="days">
                @foreach (GameDaySummary day in _days)
                {
                    <li>
                        <a href="games/@_game.Slug/days/@day.Slug">
                            <span class="day-name">@day.Label</span>
                            @if (day.Title is not null)
                            {
                                <span class="day-title">«@day.Title»</span>
                            }
                            <span class="day-meta">
                                @(day.PuzzleCount == 1 ? "1 γρίφος" : $"{day.PuzzleCount} γρίφοι")@(day.MediaCount > 0 ? $" · {day.MediaCount} υλικό" : null)
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (_posts.Count > 0)
    {
        <section class="block">
            <h2>Αναρτήσεις</h2>
            @foreach (PostDetails post in _posts)
            {
                <article class="post">
                    <header>
                        <PostDate Value="post.CreatedAt" />
                        @if (post.Title is not null)
                        {
                            <h3>@post.Title</h3>
                        }
                    </header>
                    <RichText Html="@post.Content" />
                    @if (post.Media.Count > 0)
                    {
                        <MediaSheet Items="Thumbs(post)" Gallery="@($"post-{post.Id}")" />
                    }
                </article>
            }
        </section>
    }

    <section class="block">
        <h2>Υλικό @if (_game.Media.Count > 0) { <span class="count">@_game.Media.Count</span> }</h2>
        <MediaSheet Items="_mediaThumbs" Gallery="game" />
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private GameDetails? _game;
    private List<MediaSheet.Thumb> _mediaThumbs = [];
    private IReadOnlyList<PostDetails> _posts = [];
    private IReadOnlyList<GameDaySummary> _days = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _game = await GetGameBySlugHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (GameNotFoundException)
        {
            _game = null;
            string? current = await FindSlugRedirectHandler.HandleAsync(SlugOwner.Game, Slug, CancellationToken.None);
            if (current is null)
            {
                Navigation.NotFound();
            }
            else
            {
                PermanentRedirect.To(HttpContext, Navigation, $"/games/{current}");
            }

            return;
        }

        _mediaThumbs = _game.Media.Select(m => new MediaSheet.Thumb(m.Path, m.ThumbnailPath, m.OriginalFileName)).ToList();
        _posts = await GetGamePostsHandler.HandleAsync(_game.Id, CancellationToken.None);
        _days = await GetGameDaysHandler.HandleAsync(_game.Id, CancellationToken.None);
    }

    private static List<MediaSheet.Thumb> Thumbs(PostDetails post) =>
        post.Media.Select(m => new MediaSheet.Thumb(m.Path, m.ThumbnailPath, m.OriginalFileName)).ToList();
}
