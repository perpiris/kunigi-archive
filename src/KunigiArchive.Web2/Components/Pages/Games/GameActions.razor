@page "/games/{Slug}/actions"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Games
@using KunigiArchive.Application.Games.DeleteGame
@using KunigiArchive.Application.Games.GetGameForEdit
@inject GetGameForEditHandler GetGameForEditHandler
@inject DeleteGameHandler DeleteGameHandler
@inject GetGameDaysHandler GetGameDaysHandler
@using KunigiArchive.Application.GameDays
@using KunigiArchive.Application.GameDays.GetGameDays
@inherits FormPage

@if (_game is not null)
{
    <PageTitle>@_game.OrderTitle - Ενέργειες</PageTitle>

    <header class="k-page-head">
        <h1><GameName Order="_game.Order" Year="_game.Year" /></h1>
        <a class="btn btn-outline-secondary" href="games/@_game.Slug">Δημόσια σελίδα</a>
    </header>

    <div class="row g-3">
        <ActionTile Href="@($"games/{_game.Slug}")" Title="Προβολή" Description="Η δημόσια σελίδα του παιχνιδιού." />
        <ActionTile Href="@($"games/{_game.Slug}/edit")" Title="Επεξεργασία" Description="Τίτλος, σημείωση, ιστορία, αφίσα." />
        <ActionTile Href="@($"games/{_game.Slug}/days")" Title="Ημέρες" Description="Ποιες ημέρες είχε το παιχνίδι: Χορός, Σάββατο, Κυριακή..." />
        <ActionTile Href="@($"games/{_game.Slug}/media")" Title="Υλικό" Description="Φωτογραφίες, βίντεο και αρχεία του παιχνιδιού." />
        <ActionTile Href="@($"games/{_game.Slug}/posts")" Title="Αναρτήσεις" Description="Ανακοινώσεις και νέα του παιχνιδιού." />
        <AuthorizeView Roles="@Roles.Admin">
            <ActionTile Href="@($"games/{_game.Id}/edit")" Title="Στοιχεία"
                        Description="Χρονιά, αριθμός, διοργάνωση και νικητής." />
        </AuthorizeView>
    </div>

    @* Each enabled day: its description and media, and from there its puzzles. *@
    @if (_days.Count > 0)
    {
        <h2 class="h4 mt-5 mb-3">Ημέρες</h2>
        <div class="row g-3">
            @foreach (GameDaySummary day in _days)
            {
                <ActionTile Href="@($"games/{_game.Slug}/days/{day.Slug}/edit")" Title="@day.Label"
                            Description="@($"Περιγραφή, υλικό και γρίφοι ({day.PuzzleCount}).")" />
            }
        </div>
    }

    <AuthorizeView Roles="@Roles.Admin">
        <section class="card border-danger mt-5">
            <div class="card-body">
                <h2 class="h5 card-title text-danger">Διαγραφή παιχνιδιού</h2>
                <p class="card-text">Διαγράφει το παιχνίδι, την αφίσα και όλο το υλικό του. Δεν αναιρείται.</p>
                <form method="post" @formname="delete-game" @onsubmit="DeleteAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="ConfirmDelete" value="true" />
                    <button type="submit" class="btn btn-danger"
                            data-confirm="Οριστική διαγραφή του παιχνιδιού και όλου του υλικού του;">
                        Διαγραφή παιχνιδιού
                    </button>
                </form>
            </div>
        </section>
    </AuthorizeView>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "delete-game")]
    private bool ConfirmDelete { get; set; }

    private GameDetails? _game;
    private IReadOnlyList<GameDaySummary> _days = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _game = await GetGameForEditHandler.HandleAsync(Slug, CancellationToken.None);
            _days = await GetGameDaysHandler.HandleAsync(_game.Id, CancellationToken.None);
        }
        catch (GameNotFoundException)
        {
            _game = null;
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task DeleteAsync()
    {
        if (_game is null || !ConfirmDelete)
        {
            return;
        }

        try
        {
            await DeleteGameHandler.HandleAsync(_game.Id, CancellationToken.None);
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        Done($"Το «{_game.OrderTitle}» διαγράφηκε.", "/games/manage");
    }
}
