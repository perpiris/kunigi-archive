@page "/games/{Slug}/edit"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Games
@using KunigiArchive.Application.Games.GetGameForEdit
@using KunigiArchive.Application.Games.SetGameImage
@using KunigiArchive.Application.Games.UpdateGameDetails
@using KunigiArchive.Application.Media
@using KunigiArchive.Domain.Common
@using KunigiArchive.Domain.Games
@using KunigiArchive.Web2.Forms.Games
@using KunigiArchive.Web2.Mappers
@inject GetGameForEditHandler GetGameForEditHandler
@inject UpdateGameDetailsHandler UpdateGameDetailsHandler
@inject SetGameImageHandler SetGameImageHandler
@inherits FormPage

@* The host team's part of the game. Year, number and teams are the admin's ("Στοιχεία", games/{id}/edit). *@
<PageTitle>Επεξεργασία παιχνιδιού</PageTitle>

<div class="k-form-page wide">

@if (_game is not null && Form is not null)
{
    <header class="k-page-head">
        <h1><GameName Order="_game.Order" Year="_game.Year" /></h1>
        <a class="btn btn-outline-secondary" href="games/@Slug/actions">Ενέργειες παιχνιδιού</a>
    </header>

    @if (_message is not null)
    {
        <div class="alert k-form-alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <EditForm Model="Form" FormName="edit-game" OnValidSubmit="SaveAsync" Enhance class="k-form wide">
        <DataAnnotationsValidator />
        <input type="hidden" name="Form.Id" value="@Form.Id" />
        <h2 class="k-form-title">Στοιχεία</h2>

        <div class="k-field">
            <label for="title" class="form-label">Τίτλος</label>
            <InputText id="title" class="form-control" maxlength="@Game.TitleMaxLength" placeholder="π.χ. Το Ξεκίνημα" @bind-Value="Form.Title" />
            <ValidationMessage For="() => Form.Title" />
            <div class="form-text">Το όνομα του παιχνιδιού, αν είχε. Εμφανίζεται κάτω από το «@_game.OrderTitle».</div>
        </div>

        <div class="k-field">
            <label for="note" class="form-label">Σημείωση</label>
            <InputText id="note" class="form-control" maxlength="@Game.NoteMaxLength" @bind-Value="Form.Note" />
            <ValidationMessage For="() => Form.Note" />
            <div class="form-text">Μια σύντομη φράση για ό,τι δεν λένε η διοργάνωση και ο νικητής, π.χ. «Δεν αναδείχθηκε νικητής».</div>
        </div>

        <div class="k-field">
            <label for="description" class="form-label">Το παιχνίδι</label>
            <k-rich-text>
                <InputTextArea id="description" class="form-control" rows="10" @bind-Value="Form.Description" />
            </k-rich-text>
            <div class="form-text">Η ιστορία του παιχνιδιού: το θέμα, οι αποστολές, ό,τι αξίζει να μείνει στο αρχείο.</div>
        </div>

        <div class="k-form-actions">
            <a class="btn btn-outline-secondary" href="games/@Slug/actions">Ακύρωση</a>
            <button type="submit" class="btn btn-primary">Αποθήκευση</button>
        </div>
    </EditForm>

    <section class="k-form wide">
        <h2 class="k-form-title">Αφίσα</h2>
        <div class="image-row">
            @if (_game.Image is not null)
            {
                <img class="poster-preview" src="/@_game.Image" alt="Αφίσα: @_game.OrderTitle" />
            }
            <form method="post" enctype="multipart/form-data" @formname="game-image" @onsubmit="SaveImageAsync" class="image-upload">
                <AntiforgeryToken />
                <label for="image" class="form-label">@(_game.Image is null ? "Ανέβασμα αφίσας" : "Νέα αφίσα")</label>
                <div class="k-inline-form">
                    <input id="image" type="file" name="Image" accept="@MediaRules.ImageAcceptAttribute" class="form-control" />
                    <button type="submit" class="btn btn-primary">@(_game.Image is null ? "Ανέβασμα" : "Αντικατάσταση")</button>
                </div>
                <UploadHint ImagesOnly="true" />
            </form>
        </div>
        @if (_game.Image is not null)
        {
            <form method="post" @formname="remove-game-image" @onsubmit="RemoveImageAsync" class="k-form-actions">
                <AntiforgeryToken />
                <input type="hidden" name="RemoveImage" value="true" />
                <button type="submit" class="btn btn-outline-danger"
                        data-confirm="Αφαίρεση της αφίσας;">Αφαίρεση αφίσας</button>
            </form>
        }
    </section>
}

</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "edit-game")]
    private GameDetailsForm? Form { get; set; }

    [SupplyParameterFromForm(FormName = "game-image")]
    private IFormFile? Image { get; set; }

    [SupplyParameterFromForm(FormName = "remove-game-image")]
    private bool RemoveImage { get; set; }

    private GameDetails? _game;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // When the edit form was posted its fields are kept; otherwise it starts from the saved game.
        Form ??= _game?.ToDetailsForm();
    }

    private async Task SaveAsync()
    {
        try
        {
            _game = await UpdateGameDetailsHandler.HandleAsync(Form!.ToCommand(), CancellationToken.None);
        }
        catch (DomainException exception)
        {
            (_message, _isError) = (exception.Message, true);
            return;
        }
        catch (GameNotFoundException)
        {
            Navigation.NotFound();
            return;
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        Done("Οι αλλαγές αποθηκεύτηκαν.", $"/games/{_game.Slug}/actions");
    }

    private async Task SaveImageAsync()
    {
        if (_game is null)
        {
            return;
        }

        if (Image is null || string.IsNullOrEmpty(Image.FileName))
        {
            (_message, _isError) = ("Δεν επιλέχθηκε αρχείο.", true);
            return;
        }

        await using Stream content = Image.OpenReadStream();
        await ChangeImageAsync(new MediaUpload(content, Image.FileName, Image.Length), "Η αφίσα αποθηκεύτηκε.");
    }

    private async Task RemoveImageAsync()
    {
        if (_game is not null && RemoveImage)
        {
            await ChangeImageAsync(null, "Η αφίσα αφαιρέθηκε.");
        }
    }

    private async Task ChangeImageAsync(MediaUpload? image, string success)
    {
        try
        {
            _game = await SetGameImageHandler.HandleAsync(new SetGameImageCommand(_game!.Id, image), CancellationToken.None);
            Reload(success);
        }
        catch (Exception exception) when (exception is InvalidRequestException or DomainException)
        {
            (_message, _isError) = (exception.Message, true);
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _game = await GetGameForEditHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (GameNotFoundException)
        {
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }
}
