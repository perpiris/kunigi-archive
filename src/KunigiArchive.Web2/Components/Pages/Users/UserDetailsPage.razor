@page "/users/{Id:guid}"
@attribute [Authorize(Roles = Roles.Admin)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Users
@using KunigiArchive.Application.Users.ChangeUserRole
@using KunigiArchive.Application.Users.GetUserDetails
@using KunigiArchive.Application.Users.SendTemporaryPassword
@using KunigiArchive.Application.Users.SetUserDisabled
@using KunigiArchive.Application.Users.DeleteUser
@using KunigiArchive.Web2.Forms.Users
@inject GetUserDetailsHandler GetUserDetailsHandler
@inject ChangeUserRoleHandler ChangeUserRoleHandler
@inject SendTemporaryPasswordHandler SendTemporaryPasswordHandler
@inject SetUserDisabledHandler SetUserDisabledHandler
@inject DeleteUserHandler DeleteUserHandler
@inherits FormPage

<PageTitle>Χρήστης</PageTitle>

<div class="k-form-page">

@if (_user is not null)
{
    <header class="k-page-head">
        <h1 class="text-break">@_user.Email</h1>
        @if (_user.IsDisabled)
        {
            <span class="badge text-bg-secondary">Απενεργοποιημένος</span>
        }
        <a class="btn btn-outline-secondary" href="users">Όλοι οι χρήστες</a>
    </header>

    @if (_message is not null)
    {
        <div class="alert k-form-alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <section class="k-form">
        <h2 class="k-form-title">Ρόλος</h2>
        @if (_user.IsCurrentUser)
        {
            <p class="mb-0">
                @RoleOptions.Label(_user.Role)
                <span class="text-body-secondary">· Δεν μπορείτε να αλλάξετε τον ρόλο του δικού σας λογαριασμού.</span>
            </p>
        }
        else
        {
            <form method="post" @formname="change-role" @onsubmit="ChangeRoleAsync">
                <AntiforgeryToken />
                <div class="k-inline-form">
                    <select name="Role" class="form-select" aria-label="Ρόλος">
                        @foreach ((string value, string label) in RoleOptions.All)
                        {
                            <option value="@value" selected="@(value == (_user.Role ?? string.Empty))">@label</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Αλλαγή</button>
                </div>
            </form>
            @if (_user.Role == Roles.Manager && _user.ManagedTeams.Count > 0)
            {
                <div class="form-text">Αν αλλάξει ο ρόλος, ο χρήστης αφαιρείται από τις ομάδες που διαχειρίζεται.</div>
            }
        }
    </section>

    @if (_user.Role == Roles.Manager)
    {
        <section class="k-form">
            <h2 class="k-form-title">Ομάδες</h2>
            @if (_user.ManagedTeams.Count == 0)
            {
                <p class="k-empty mb-0">Δεν διαχειρίζεται καμία ομάδα. Προσθέστε τον από τη σελίδα «Διαχειριστές» μιας ομάδας.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (TeamSummary team in _user.ManagedTeams)
                    {
                        <li>@team.Name</li>
                    }
                </ul>
            }
        </section>
    }

    @if (!_user.IsDisabled)
    {
        <section class="k-form">
            <h2 class="k-form-title">Προσωρινός κωδικός</h2>
            <p class="mb-0">
                Στέλνει στον χρήστη email με νέο προσωρινό κωδικό. Ο τρέχων κωδικός του παύει να ισχύει
                και αποσυνδέεται από όπου είναι συνδεδεμένος. Μόλις συνδεθεί, πρέπει να ορίσει δικό του κωδικό.
            </p>
            <form method="post" @formname="temporary-password" @onsubmit="SendTemporaryPasswordAsync" class="k-form-actions">
                <AntiforgeryToken />
                <input type="hidden" name="ConfirmSend" value="true" />
                <button type="submit" class="btn btn-outline-danger"
                        data-confirm="Αποστολή νέου προσωρινού κωδικού; Ο τρέχων κωδικός θα πάψει να ισχύει.">
                    Αποστολή νέου κωδικού
                </button>
            </form>
        </section>
    }

    @* Not for your own account: there's always an admin who can sign in. *@
    @if (!_user.IsCurrentUser)
    {
        <section class="k-form">
            <h2 class="k-form-title">Λογαριασμός</h2>
            <p class="mb-0">
                @if (_user.IsDisabled)
                {
                    <text>Ο λογαριασμός είναι απενεργοποιημένος: δεν μπορεί να συνδεθεί ούτε να επαναφέρει τον κωδικό του.</text>
                }
                else
                {
                    <text>Η απενεργοποίηση κρατά τον λογαριασμό και τις ομάδες του, αλλά δεν τον αφήνει να συνδεθεί.
                    Η διαγραφή τον αφαιρεί οριστικά, μαζί με τις αναθέσεις του σε ομάδες.</text>
                }
            </p>
            <div class="k-form-actions">
                <form method="post" @formname="set-disabled" @onsubmit="SetDisabledAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="Disable" value="@(_user.IsDisabled ? "false" : "true")" />
                    @if (_user.IsDisabled)
                    {
                        <button type="submit" class="btn btn-primary">Ενεργοποίηση</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-danger"
                                data-confirm="Απενεργοποίηση του λογαριασμού; Θα αποσυνδεθεί μέσα σε ένα λεπτό.">
                            Απενεργοποίηση
                        </button>
                    }
                </form>
                <form method="post" @formname="delete-user" @onsubmit="DeleteAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="ConfirmDelete" value="true" />
                    <button type="submit" class="btn btn-danger"
                            data-confirm="Οριστική διαγραφή του λογαριασμού @_user.Email; Δεν αναιρείται.">
                        Διαγραφή
                    </button>
                </form>
            </div>
        </section>
    }
}

</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "change-role")]
    private string? Role { get; set; }

    [SupplyParameterFromForm(FormName = "temporary-password")]
    private bool ConfirmSend { get; set; }

    [SupplyParameterFromForm(FormName = "set-disabled")]
    private bool? Disable { get; set; }

    [SupplyParameterFromForm(FormName = "delete-user")]
    private bool ConfirmDelete { get; set; }

    private UserDetails? _user;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ChangeRoleAsync()
    {
        try
        {
            await ChangeUserRoleHandler.HandleAsync(new ChangeUserRoleCommand(Id, Role), CancellationToken.None);
            Reload("Ο ρόλος ενημερώθηκε.");
        }
        catch (InvalidRequestException exception)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task SendTemporaryPasswordAsync()
    {
        if (!ConfirmSend)
        {
            return;
        }

        try
        {
            await SendTemporaryPasswordHandler.HandleAsync(Id, CancellationToken.None);
            Reload("Στάλθηκε email με νέο προσωρινό κωδικό.");
        }
        catch (EmailDeliveryException)
        {
            (_message, _isError) = ("Το email δεν στάλθηκε. Ο κωδικός άλλαξε ήδη, οπότε δοκιμάστε ξανά: " +
                                    "κάθε αποστολή ορίζει νέο κωδικό.", true);
        }
        catch (InvalidRequestException exception)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task SetDisabledAsync()
    {
        if (Disable is not bool disable)
        {
            return;
        }

        try
        {
            await SetUserDisabledHandler.HandleAsync(Id, disable, CancellationToken.None);
            Reload(disable ? "Ο λογαριασμός απενεργοποιήθηκε." : "Ο λογαριασμός ενεργοποιήθηκε.");
        }
        catch (InvalidRequestException exception)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!ConfirmDelete)
        {
            return;
        }

        try
        {
            await DeleteUserHandler.HandleAsync(Id, CancellationToken.None);
            Done("Ο λογαριασμός διαγράφηκε.", "/users");
            return;
        }
        catch (InvalidRequestException exception)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _user = await GetUserDetailsHandler.HandleAsync(Id, CancellationToken.None);
        }
        catch (UserNotFoundException)
        {
            _user = null;
            Navigation.NotFound();
        }
    }
}
