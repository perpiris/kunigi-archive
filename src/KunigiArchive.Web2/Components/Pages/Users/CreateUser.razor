@page "/users/create"
@attribute [Authorize(Roles = Roles.Admin)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Users.CreateUser
@using KunigiArchive.Web2.Forms.Users
@using KunigiArchive.Web2.Mappers
@inject CreateUserHandler CreateUserHandler
@inherits FormPage

<PageTitle>Νέος χρήστης</PageTitle>

<div class="k-form-page">

<header class="k-page-head">
    <h1>Νέος χρήστης</h1>
</header>

@if (_error is not null)
{
    <div class="alert alert-danger k-form-alert" role="alert">@_error</div>
}

<EditForm Model="Form" FormName="create-user" OnValidSubmit="CreateAsync" Enhance class="k-form">
    <DataAnnotationsValidator />

    <div class="k-field-row">
        <div class="k-field">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" type="email" class="form-control" autocomplete="off" @bind-Value="Form.Email" />
            <ValidationMessage For="() => Form.Email" />
        </div>
        <div class="k-field">
            <label for="role" class="form-label">Ρόλος</label>
            <InputSelect id="role" class="form-select" @bind-Value="Form.Role">
                @foreach ((string value, string label) in RoleOptions.All)
                {
                    <option value="@value">@label</option>
                }
            </InputSelect>
        </div>
    </div>

    <p class="form-text mb-0">Ο χρήστης θα λάβει email με έναν προσωρινό κωδικό για να συνδεθεί.</p>

    <div class="k-form-actions">
        <a class="btn btn-outline-secondary" href="users">Ακύρωση</a>
        <button type="submit" class="btn btn-primary">Δημιουργία</button>
    </div>
</EditForm>

</div>

@code {
    [SupplyParameterFromForm]
    private CreateUserForm Form { get; set; } = null!;

    private string? _error;

    protected override void OnInitialized()
    {
        Form ??= new CreateUserForm();
    }

    private async Task CreateAsync()
    {
        CreateUserResult result;
        try
        {
            result = await CreateUserHandler.HandleAsync(Form.ToCommand(), CancellationToken.None);
        }
        catch (Exception exception) when (exception is InvalidRequestException or ConflictException)
        {
            _error = exception.Message;
            return;
        }

        if (result.EmailSent)
        {
            Done("Ο χρήστης δημιουργήθηκε και του στάλθηκε email με τον προσωρινό κωδικό.", "/users");
            return;
        }

        // The account exists but the email failed: its page is where a new temporary password is sent.
        Flash.Error(HttpContext, "Ο χρήστης δημιουργήθηκε, αλλά το email με τον προσωρινό κωδικό δεν στάλθηκε. " +
                                 "Στείλτε νέο κωδικό από κάτω όταν το email λειτουργεί.");
        Navigation.NavigateTo($"/users/{result.UserId}");
    }
}
