@page "/games/{Slug}/days/{DaySlug}/puzzles/create"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.GameDays
@using KunigiArchive.Application.GameDays.GetGameDays
@using KunigiArchive.Application.GameDays.ManagePuzzles
@using KunigiArchive.Domain.Common
@using KunigiArchive.Web2.Forms.GameDays
@inject GetGameDayForEditHandler GetGameDayForEditHandler
@inject CreatePuzzleHandler CreatePuzzleHandler
@inherits FormPage

<PageTitle>Νέος γρίφος</PageTitle>

<div class="k-form-page wide">

@if (_page is not null)
{
    <header class="k-page-head">
        <h1>Νέος γρίφος</h1>
        <a class="btn btn-outline-secondary" href="games/@Slug/days/@DaySlug/puzzles">Γρίφοι</a>
    </header>
    <p class="text-body-secondary">
        <GameName Order="_page.Game.Order" Year="_page.Game.Year" /> · @_page.Day.Label ·
        γρίφος @(_page.Day.Puzzles.Count + 1)
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger k-form-alert" role="alert">@_error</div>
    }

    <EditForm Model="Form" FormName="create-puzzle" OnValidSubmit="CreateAsync" Enhance class="k-form wide">
        <DataAnnotationsValidator />
        <PuzzleFields Form="Form" />
        <p class="form-text mb-0">Εικόνες και βίντεο της ερώτησης και της απάντησης προστίθενται μετά την αποθήκευση.</p>

        <div class="k-form-actions">
            <a class="btn btn-outline-secondary" href="games/@Slug/days/@DaySlug/puzzles">Ακύρωση</a>
            <button type="submit" class="btn btn-primary">Αποθήκευση</button>
        </div>
    </EditForm>
}

</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string DaySlug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "create-puzzle")]
    private PuzzleForm Form { get; set; } = null!;

    private GameDayPage? _page;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Form ??= new PuzzleForm();

        try
        {
            _page = await GetGameDayForEditHandler.HandleAsync(Slug, DaySlug, CancellationToken.None);
        }
        catch (NotFoundException)
        {
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task CreateAsync()
    {
        if (_page is null)
        {
            return;
        }

        PuzzleDetails puzzle;
        try
        {
            puzzle = await CreatePuzzleHandler.HandleAsync(
                new PuzzleCommand(_page.Day.Id, Guid.Empty, Form.Group, Form.Question, Form.Answer), CancellationToken.None);
        }
        catch (DomainException exception)
        {
            _error = exception.Message;
            return;
        }

        // On to its edit page, where the pictures are added.
        Done($"Ο γρίφος {puzzle.Order} αποθηκεύτηκε. Προσθέστε τις εικόνες του, αν έχει.", $"/games/{Slug}/days/{DaySlug}/puzzles/{puzzle.Id}");
    }
}
