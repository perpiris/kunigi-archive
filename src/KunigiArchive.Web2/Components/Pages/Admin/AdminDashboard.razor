<header class="k-page-head">
    <h1>Πίνακας διαχείρισης</h1>
</header>

@* Game management and media status get their tiles as those features move over from the old app. *@
<div class="row g-3">
    <ActionTile Href="teams/manage" Title="Διαχείριση ομάδων" Description="Δημιουργία, επεξεργασία, διαχειριστές." />
