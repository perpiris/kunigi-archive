@page "/auth/forgot-password"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(KunigiArchive.Web2.Middleware.RateLimitPolicies.PasswordResetEmail)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Users.ResetPassword
@using KunigiArchive.Web2.Forms.Auth
@inject RequestPasswordResetHandler RequestPasswordResetHandler

<PageTitle>Ξέχασα τον κωδικό</PageTitle>

<div class="k-form-page narrow">
    <header class="k-page-head">
        <h1>Ξέχασα τον κωδικό</h1>
    </header>

    @if (_sent)
    {
        @* The same answer whether or not the account exists, so the page doesn't reveal who has one. *@
        <div class="alert alert-success" role="status">
            Αν υπάρχει λογαριασμός με το <strong>@Form.Email</strong>, θα λάβετε σε λίγο email με σύνδεσμο για νέο κωδικό.
            Ο σύνδεσμος ισχύει για μία ώρα.
        </div>
        <p><a href="auth/login">Επιστροφή στη σύνδεση</a></p>
    }
    else
    {
        <p class="text-body-secondary">Γράψτε το email του λογαριασμού σας και θα σας στείλουμε σύνδεσμο για να ορίσετε νέο κωδικό.</p>

        <EditForm Model="Form" FormName="forgot-password" OnValidSubmit="SendAsync" Enhance class="k-form">
            <DataAnnotationsValidator />

            <div class="k-field mb-0">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" type="email" autocomplete="username" class="form-control" @bind-Value="Form.Email" />
                <ValidationMessage For="() => Form.Email" />
            </div>

            <div class="k-form-actions">
                <button type="submit" class="btn btn-primary w-100">Αποστολή συνδέσμου</button>
            </div>
        </EditForm>

        <p class="mt-3 text-center"><a href="auth/login">Επιστροφή στη σύνδεση</a></p>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordForm Form { get; set; } = null!;

    private bool _sent;

    protected override void OnInitialized()
    {
        Form ??= new ForgotPasswordForm();
    }

    private async Task SendAsync()
    {
        try
        {
            await RequestPasswordResetHandler.HandleAsync(Form.Email, CancellationToken.None);
        }
        catch (InvalidRequestException)
        {
            // An address the form accepted but the rules don't: nothing to send, same answer.
        }

        _sent = true;
    }
}
