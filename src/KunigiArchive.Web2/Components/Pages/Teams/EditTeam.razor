@page "/teams/{Slug}/edit"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Media
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamForEdit
@using KunigiArchive.Application.Teams.SetTeamImage
@using KunigiArchive.Application.Teams.UpdateTeam
@using KunigiArchive.Domain.Common
@using KunigiArchive.Web2.Forms.Teams
@using KunigiArchive.Web2.Mappers
@inject GetTeamForEditHandler GetTeamForEditHandler
@inject UpdateTeamHandler UpdateTeamHandler
@inject SetTeamImageHandler SetTeamImageHandler
@inherits FormPage

<PageTitle>Επεξεργασία ομάδας</PageTitle>

<div class="k-form-page wide">

@if (_team is not null && Form is not null)
{
    <header class="k-page-head">
        <h1>@_team.Name</h1>
        <a class="btn btn-outline-secondary" href="teams/@Slug/actions">Ενέργειες ομάδας</a>
    </header>

    @if (_message is not null)
    {
        <div class="alert k-form-alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <EditForm Model="Form" FormName="edit-team" OnValidSubmit="SaveAsync" Enhance class="k-form wide">
        <DataAnnotationsValidator />
        <input type="hidden" name="Form.Id" value="@Form.Id" />
        <h2 class="k-form-title">Στοιχεία</h2>

        <div class="k-field-row">
            <div class="k-field">
                <label for="name" class="form-label">Όνομα ομάδας</label>
                <AuthorizeView Roles="@Roles.Admin" Context="auth">
                    <Authorized>
                        <InputText id="name" class="form-control" @bind-Value="Form.Name" />
                        <ValidationMessage For="() => Form.Name" />
                    </Authorized>
                    <NotAuthorized>
                        @* Still posted (readonly, not disabled), so the form stays valid; the handler refuses a change. *@
                        <InputText id="name" class="form-control" readonly @bind-Value="Form.Name" />
                        <div class="form-text">Το όνομα αλλάζει μόνο από τον γενικό διαχειριστή.</div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <AuthorizeView Roles="@Roles.Admin" Context="auth">
                <div class="k-field">
                    <label for="slug" class="form-label">Διεύθυνση</label>
                    <div class="input-group">
                        <span class="input-group-text">/teams/</span>
                        <InputText id="slug" class="form-control" @bind-Value="Form.Slug" />
                    </div>
                    <div class="form-text">Αν μείνει κενό, κρατιέται η τρέχουσα. Αν αλλάξει, οι παλιοί σύνδεσμοι οδηγούν αυτόματα στη νέα.</div>
                </div>
            </AuthorizeView>
        </div>

        <div class="k-field-row align-items-end">
            <div class="k-field short">
                <label for="year-founded" class="form-label">Έτος ίδρυσης</label>
                <InputNumber id="year-founded" class="form-control" inputmode="numeric" @bind-Value="Form.YearFounded" />
                <ValidationMessage For="() => Form.YearFounded" />
            </div>
            <div class="k-field">
                <div class="form-check">
                    <InputCheckbox id="is-active" class="form-check-input" @bind-Value="Form.IsActive" />
                    <label for="is-active" class="form-check-label">Ενεργή ομάδα</label>
                </div>
            </div>
        </div>

        <div class="k-field">
            <label for="description" class="form-label">Ιστορία της ομάδας</label>
            <k-rich-text>
                <InputTextArea id="description" class="form-control" rows="8" @bind-Value="Form.Description" />
            </k-rich-text>
            <div class="form-text">Επικεφαλίδες, έντονα, λίστες, παραθέσεις και σύνδεσμοι. Χρώματα και μεγέθη ακολουθούν το θέμα.</div>
        </div>

        <h2 class="k-form-title mt-4">Σύνδεσμοι</h2>
        <div class="k-field-row">
            <div class="k-field">
                <label for="facebook" class="form-label">Facebook</label>
                <InputText id="facebook" type="url" class="form-control" placeholder="https://facebook.com/…" @bind-Value="Form.Facebook" />
            </div>
            <div class="k-field">
                <label for="instagram" class="form-label">Instagram</label>
                <InputText id="instagram" type="url" class="form-control" placeholder="https://instagram.com/…" @bind-Value="Form.Instagram" />
            </div>
            <div class="k-field">
                <label for="youtube" class="form-label">YouTube</label>
                <InputText id="youtube" type="url" class="form-control" placeholder="https://youtube.com/…" @bind-Value="Form.Youtube" />
            </div>
            <div class="k-field">
                <label for="website" class="form-label">Ιστοσελίδα</label>
                <InputText id="website" type="url" class="form-control" placeholder="https://…" @bind-Value="Form.Website" />
            </div>
        </div>

        <div class="k-form-actions">
            <a class="btn btn-outline-secondary" href="teams/@Slug/actions">Ακύρωση</a>
            <button type="submit" class="btn btn-primary">Αποθήκευση</button>
        </div>
    </EditForm>

    <section class="k-form wide">
        <h2 class="k-form-title">Εικόνα</h2>
        <div class="image-row">
            @if (_team.Image is not null)
            {
                <img class="team-image-preview" src="/@_team.Image" alt="@_team.Name" />
            }
            <form method="post" enctype="multipart/form-data" @formname="team-image" @onsubmit="SaveImageAsync" class="image-upload">
                <AntiforgeryToken />
                <label for="image" class="form-label">@(_team.Image is null ? "Ανέβασμα εικόνας" : "Νέα εικόνα")</label>
                <div class="k-inline-form">
                    <input id="image" type="file" name="Image" accept="@MediaRules.ImageAcceptAttribute" class="form-control" />
                    <button type="submit" class="btn btn-primary">@(_team.Image is null ? "Ανέβασμα" : "Αντικατάσταση")</button>
                </div>
                <UploadHint ImagesOnly="true" />
            </form>
        </div>
        @if (_team.Image is not null)
        {
            <form method="post" @formname="remove-team-image" @onsubmit="RemoveImageAsync" class="k-form-actions">
                <AntiforgeryToken />
                <input type="hidden" name="RemoveImage" value="true" />
                <button type="submit" class="btn btn-outline-danger"
                        data-confirm="Αφαίρεση της εικόνας;">Αφαίρεση εικόνας</button>
            </form>
        }
    </section>
}

</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "edit-team")]
    private EditTeamForm? Form { get; set; }

    [SupplyParameterFromForm(FormName = "team-image")]
    private IFormFile? Image { get; set; }

    [SupplyParameterFromForm(FormName = "remove-team-image")]
    private bool RemoveImage { get; set; }

    private TeamDetails? _team;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // When the edit form was posted its fields are kept; otherwise it starts from the saved team.
        Form ??= _team?.ToEditForm();
    }

    private async Task SaveImageAsync()
    {
        if (_team is null)
        {
            return;
        }

        if (Image is null || string.IsNullOrEmpty(Image.FileName))
        {
            (_message, _isError) = ("Δεν επιλέχθηκε αρχείο.", true);
            return;
        }

        await using Stream content = Image.OpenReadStream();
        await ChangeImageAsync(new MediaUpload(content, Image.FileName, Image.Length), "Η εικόνα αποθηκεύτηκε.");
    }

    private async Task RemoveImageAsync()
    {
        if (_team is not null && RemoveImage)
        {
            await ChangeImageAsync(null, "Η εικόνα αφαιρέθηκε.");
        }
    }

    private async Task ChangeImageAsync(MediaUpload? image, string success)
    {
        try
        {
            _team = await SetTeamImageHandler.HandleAsync(new SetTeamImageCommand(_team!.Id, image), CancellationToken.None);
            Reload(success);
        }
        catch (Exception exception) when (exception is InvalidRequestException or DomainException)
        {
            (_message, _isError) = (exception.Message, true);
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _team = await GetTeamForEditHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (TeamNotFoundException)
        {
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task SaveAsync()
    {
        TeamDetails team;
        try
        {
            team = await UpdateTeamHandler.HandleAsync(Form!.ToCommand(), CancellationToken.None);
        }
        catch (Exception exception) when (exception is DomainException or ConflictException)
        {
            (_message, _isError) = (exception.Message, true);
            return;
        }
        catch (TeamNotFoundException)
        {
            Navigation.NotFound();
            return;
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        Done("Οι αλλαγές αποθηκεύτηκαν.", $"/teams/{team.Slug}/actions");
    }
}
