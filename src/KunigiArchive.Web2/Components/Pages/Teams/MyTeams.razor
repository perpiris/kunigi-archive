@page "/my-teams"
@attribute [Authorize(Roles = Roles.Manager)]
@using KunigiArchive.Application.Games
@using KunigiArchive.Application.Games.GetMyGames
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetMyTeams
@inject GetMyTeamsHandler GetMyTeamsHandler
@inject GetMyGamesHandler GetMyGamesHandler

<PageTitle>Οι ομάδες μου</PageTitle>

<header class="k-page-head">
    <h1>Οι ομάδες μου</h1>
</header>

@if (_teams is not null && _games is not null)
{
    @if (_teams.Count == 0)
    {
        <p class="text-body-secondary">Δεν διαχειρίζεστε καμία ομάδα ακόμα.</p>
    }
    else
    {
        <div class="k-table">
        <table class="table align-middle k-sortable">
            <thead>
                <tr>
                    <th>Όνομα</th>
                    <th class="text-end" data-no-sort>Ενέργειες</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TeamSummary team in _teams)
                {
                    <tr>
                        <td><a href="teams/@team.Slug">@team.Name</a></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="teams/@team.Slug/actions">Ενέργειες</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        @* The games these teams hosted: their managers fill in the title, story, poster and material. *@
        <h2 class="h4 mt-5">Παιχνίδια που διοργανώσατε</h2>
        @if (_games.Count == 0)
        {
            <p class="text-body-secondary">Οι ομάδες σας δεν έχουν διοργανώσει ακόμα παιχνίδι στο αρχείο.</p>
        }
        else
        {
            <div class="k-table">
            <table class="table align-middle k-sortable">
                <thead>
                    <tr>
                        <th>Χρονιά</th>
                        <th>Παιχνίδι</th>
                        <th class="text-end" data-no-sort>Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (GameSummary game in _games)
                    {
                        <tr>
                            <td class="text-nowrap">@game.Year</td>
                            <td data-sort-value="@game.Year"><a href="games/@game.Slug"><GameName Order="game.Order" Year="game.Year" /></a></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="games/@game.Slug/actions">Ενέργειες</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
}

@code {
    private IReadOnlyList<TeamSummary>? _teams;
    private IReadOnlyList<GameSummary>? _games;

    protected override async Task OnInitializedAsync()
    {
        _teams = await GetMyTeamsHandler.HandleAsync(CancellationToken.None);
        _games = await GetMyGamesHandler.HandleAsync(CancellationToken.None);
    }
}
