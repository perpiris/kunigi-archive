@page "/teams/{Slug}/actions"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamForEdit
@inject GetTeamForEditHandler GetTeamForEditHandler
@inject NavigationManager Navigation

@if (_team is not null)
{
    <PageTitle>@_team.Name - Ενέργειες</PageTitle>

    <h1 class="mb-4">@_team.Name</h1>

    <div class="row g-3">
        <ActionTile Href="@($"teams/{_team.Slug}")" Title="Προβολή" Description="Η δημόσια σελίδα της ομάδας." />
        <ActionTile Href="@($"teams/{_team.Slug}/edit")" Title="Επεξεργασία" Description="Όνομα, περιγραφή, σύνδεσμοι." />
        <ActionTile Href="@($"teams/{_team.Slug}/media")" Title="Υλικό" Description="Φωτογραφίες και αρχεία της ομάδας." />
        <AuthorizeView Roles="@Roles.Admin">
            <ActionTile Href="@($"teams/{_team.Slug}/managers")" Title="Διαχειριστές"
                        Description="Ποιοι χρήστες διαχειρίζονται την ομάδα." />
        </AuthorizeView>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private TeamDetails? _team;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _team = await GetTeamForEditHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (TeamNotFoundException)
        {
            _team = null;
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }
}
