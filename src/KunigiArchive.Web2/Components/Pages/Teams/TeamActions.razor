@page "/teams/{Slug}/actions"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.DeleteTeam
@using KunigiArchive.Application.Teams.GetTeamForEdit
@inject GetTeamForEditHandler GetTeamForEditHandler
@inject DeleteTeamHandler DeleteTeamHandler
@inherits FormPage

@if (_team is not null)
{
    <PageTitle>@_team.Name - Ενέργειες</PageTitle>

    <header class="k-page-head">
        <h1>@_team.Name</h1>
        <a class="btn btn-outline-secondary" href="teams/@_team.Slug">Δημόσια σελίδα</a>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="row g-3">
        <ActionTile Href="@($"teams/{_team.Slug}")" Title="Προβολή" Description="Η δημόσια σελίδα της ομάδας." />
        <ActionTile Href="@($"teams/{_team.Slug}/edit")" Title="Επεξεργασία" Description="Όνομα, εικόνα, περιγραφή, σύνδεσμοι." />
        <ActionTile Href="@($"teams/{_team.Slug}/media")" Title="Υλικό" Description="Φωτογραφίες και αρχεία της ομάδας." />
        <AuthorizeView Roles="@Roles.Admin">
            <ActionTile Href="@($"teams/{_team.Slug}/managers")" Title="Διαχειριστές"
                        Description="Ποιοι χρήστες διαχειρίζονται την ομάδα." />
        </AuthorizeView>
    </div>

    <AuthorizeView Roles="@Roles.Admin">
        <section class="card border-danger mt-5">
            <div class="card-body">
                <h2 class="h5 card-title text-danger">Διαγραφή ομάδας</h2>
                <p class="card-text">
                    Διαγράφει την ομάδα, τους διαχειριστές της και όλο το υλικό της. Δεν αναιρείται.
                    Ομάδες που έχουν διοργανώσει ή κερδίσει παιχνίδι δεν διαγράφονται.
                </p>
                <form method="post" @formname="delete-team" @onsubmit="DeleteAsync">
                    <AntiforgeryToken />
                    <input type="hidden" name="ConfirmDelete" value="true" />
                    <button type="submit" class="btn btn-danger"
                            data-confirm="Οριστική διαγραφή της ομάδας και όλου του υλικού της;">
                        Διαγραφή ομάδας
                    </button>
                </form>
            </div>
        </section>
    </AuthorizeView>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "delete-team")]
    private bool ConfirmDelete { get; set; }

    private TeamDetails? _team;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _team = await GetTeamForEditHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (TeamNotFoundException)
        {
            _team = null;
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private async Task DeleteAsync()
    {
        if (_team is null || !ConfirmDelete)
        {
            return;
        }

        try
        {
            await DeleteTeamHandler.HandleAsync(_team.Id, CancellationToken.None);
        }
        catch (ConflictException exception)
        {
            _error = exception.Message;
            return;
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        Done($"Η ομάδα «{_team.Name}» διαγράφηκε.", "/teams/manage");
    }
}
