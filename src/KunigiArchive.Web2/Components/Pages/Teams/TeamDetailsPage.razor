@page "/teams/{Slug}"
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamProfile
@inject GetTeamProfileHandler GetTeamProfileHandler
@inject NavigationManager Navigation

@if (_team is not null)
{
    <PageTitle>@_team.Name</PageTitle>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1>@_team.Name</h1>
            <span class="badge @(_team.IsActive ? "text-bg-success" : "text-bg-secondary")">
                @(_team.IsActive ? "Ενεργή" : "Ανενεργή")
            </span>
        </div>
        @if (_profile!.CanEdit)
        {
            <a class="btn btn-outline-primary" href="teams/@_team.Slug/actions">Ενέργειες</a>
        }
    </div>

    @if (_team.Image is not null)
    {
        <img class="team-image mb-3" src="/@_team.Image" alt="@_team.Name" />
    }

    @if (_team.YearFounded is not null)
    {
        <p><strong>Έτος ίδρυσης:</strong> @_team.YearFounded</p>
    }

    @if (_team.Description is not null)
    {
        <p class="team-description">@_team.Description</p>
    }

    @if (_links.Count > 0)
    {
        <ul class="list-inline">
            @foreach ((string label, string url) in _links)
            {
                <li class="list-inline-item">
                    <a href="@url" target="_blank" rel="noopener noreferrer">@label</a>
                </li>
            }
        </ul>
    }

    <div class="row mt-4">
        <div class="col-md-6">
            <h2 class="h4">Διοργανώσεις</h2>
            <GameList Games="_profile.HostedGames" Empty="Δεν έχει διοργανώσει παιχνίδι." />
        </div>
        <div class="col-md-6">
            <h2 class="h4">Νίκες</h2>
            <GameList Games="_profile.WonGames" Empty="Δεν έχει κερδίσει παιχνίδι." />
        </div>
    </div>

    <h2 class="h4 mt-4">Αρχεία</h2>
    @if (_team.Media.Count == 0)
    {
        <p class="text-body-secondary">Δεν υπάρχουν αρχεία.</p>
    }
    else
    {
        <div class="media-grid">
            @foreach (TeamMediaDetails media in _team.Media)
            {
                <a href="/@media.Path" target="_blank" rel="noopener">
                    <img src="/@media.ThumbnailPath" alt="@media.OriginalFileName" loading="lazy"
                         onerror="this.onerror=null;this.src='/@media.Path'" />
                </a>
            }
        </div>
    }

    <p class="mt-4"><a href="teams">← Όλες οι ομάδες</a></p>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private TeamProfile? _profile;
    private TeamDetails? _team;
    private List<(string Label, string Url)> _links = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _profile = await GetTeamProfileHandler.HandleAsync(Slug, CancellationToken.None);
            _team = _profile.Team;
        }
        catch (TeamNotFoundException)
        {
            (_profile, _team) = (null, null);
            Navigation.NotFound();
            return;
        }

        _links = new List<(string Label, string? Url)>
            {
                ("Facebook", _team.Facebook),
                ("Instagram", _team.Instagram),
                ("YouTube", _team.Youtube),
                ("Ιστοσελίδα", _team.Website)
            }
            .Where(link => link.Url is not null)
            .Select(link => (link.Label, link.Url!))
            .ToList();
    }
}
