@page "/teams/{Slug}"
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamProfile
@using KunigiArchive.Application.Common
@inject GetTeamProfileHandler GetTeamProfileHandler
@inject FindSlugRedirectHandler FindSlugRedirectHandler
@inject NavigationManager Navigation
@inject KunigiArchive.Application.Abstractions.IRichTextSanitizer Sanitizer

@if (_team is not null)
{
    <PageTitle>@_team.Name</PageTitle>

    <section class="record">
        <TeamFrame Name="@_team.Name" Image="@_team.Image" />
        <div>
            <h1>@_team.Name</h1>
            <dl class="facts">
                @if (_team.YearFounded is not null)
                {
                    <dt>Ίδρυση</dt>
                    <dd>@_team.YearFounded</dd>
                }
                <dt>Κατάσταση</dt>
                <dd><span class="k-stamp @(_team.IsActive ? null : "muted")">@(_team.IsActive ? "Ενεργή" : "Ανενεργή")</span></dd>
            </dl>
            @if (_links.Count > 0)
            {
                <ul class="links">
                    @foreach ((string label, string url, SocialIcon.Kind icon) in _links)
                    {
                        <li>
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <SocialIcon Icon="icon" />@label
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    @* One column: history, the games, then the material full width, so any number of photos fits. *@
    @* Empty sections aren't rendered at all. Rich text counts as empty when it has no visible text. *@
    @if (Sanitizer.Sanitize(_team.Description) is not null)
    {
        <section class="block">
            <h2>Η ιστορία της ομάδας</h2>
            <RichText Html="@_team.Description" Class="history" />
        </section>
    }

    @if (_profile!.HostedGames.Count > 0 || _profile.WonGames.Count > 0)
    {
        @* An empty column is left out too; the one that's left takes the full width. *@
        <section class="block">
            <h2>Στο αρχείο</h2>
            <div class="ledger-grid">
                @if (_profile.HostedGames.Count > 0)
                {
                    <div class="ledger-col">
                        <h3 class="k-label">Διοργανώσεις</h3>
                        <GameList Games="_profile.HostedGames" />
                    </div>
                }
                @if (_profile.WonGames.Count > 0)
                {
                    <div class="ledger-col">
                        <h3 class="k-label">Νίκες</h3>
                        <GameList Games="_profile.WonGames" />
                    </div>
                }
            </div>
        </section>
    }

    @if (_team.Media.Count > 0)
    {
        <section class="block">
            <h2>Υλικό <span class="count">@_team.Media.Count</span></h2>
            <MediaSheet Items="_mediaThumbs" Gallery="team" />
        </section>
    }
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private TeamProfile? _profile;
    private TeamDetails? _team;
    private List<(string Label, string Url, SocialIcon.Kind Icon)> _links = [];
    private List<MediaSheet.Thumb> _mediaThumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _profile = await GetTeamProfileHandler.HandleAsync(Slug, CancellationToken.None);
            _team = _profile.Team;
        }
        catch (TeamNotFoundException)
        {
            (_profile, _team) = (null, null);
            string? current = await FindSlugRedirectHandler.HandleAsync(SlugOwner.Team, Slug, CancellationToken.None);
            if (current is null)
            {
                Navigation.NotFound();
            }
            else
            {
                PermanentRedirect.To(HttpContext, Navigation, $"/teams/{current}");
            }

            return;
        }

        _mediaThumbs = _team.Media.Select(m => new MediaSheet.Thumb(m.Path, m.ThumbnailPath, m.OriginalFileName)).ToList();

        _links = new List<(string Label, string? Url, SocialIcon.Kind Icon)>
            {
                ("Facebook", _team.Facebook, SocialIcon.Kind.Facebook),
                ("Instagram", _team.Instagram, SocialIcon.Kind.Instagram),
                ("YouTube", _team.Youtube, SocialIcon.Kind.Youtube),
                ("Ιστοσελίδα", _team.Website, SocialIcon.Kind.Website)
            }
            .Where(link => link.Url is not null)
            .Select(link => (link.Label, link.Url!, link.Icon))
            .ToList();
    }
}
