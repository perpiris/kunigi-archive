@page "/teams/{Slug}"
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamProfile
@inject GetTeamProfileHandler GetTeamProfileHandler
@inject NavigationManager Navigation

@if (_team is not null)
{
    <PageTitle>@_team.Name</PageTitle>

    <section class="record">
        <TeamFrame Name="@_team.Name" Image="@_team.Image" Class="natural" />
        <div>
            <h1>@_team.Name</h1>
            <dl class="facts">
                @if (_team.YearFounded is not null)
                {
                    <dt>Ίδρυση</dt>
                    <dd>@_team.YearFounded</dd>
                }
                <dt>Κατάσταση</dt>
                <dd><span class="k-stamp @(_team.IsActive ? null : "muted")">@(_team.IsActive ? "Ενεργή" : "Ανενεργή")</span></dd>
            </dl>
            @if (_links.Count > 0)
            {
                <ul class="links">
                    @foreach ((string label, string url) in _links)
                    {
                        <li><a href="@url" target="_blank" rel="noopener noreferrer">@label</a></li>
                    }
                </ul>
            }
        </div>
    </section>

    @* One column: history, the games, then the material full width, so any number of photos fits. *@
    @if (_team.Description is not null)
    {
        <section class="block">
            <h2>Η ιστορία της ομάδας</h2>
            <RichText Html="@_team.Description" Class="history" />
        </section>
    }

    <section class="block">
        <h2>Στο αρχείο</h2>
        <div class="ledger-grid">
            <div class="ledger-col">
                <h3 class="k-label">Διοργανώσεις</h3>
                <GameList Games="_profile!.HostedGames" Empty="Δεν έχει διοργανώσει ακόμη Κυνήγι." />
            </div>
            <div class="ledger-col">
                <h3 class="k-label">Νίκες</h3>
                <GameList Games="_profile.WonGames" Empty="Δεν έχει καταγραφεί νίκη." />
            </div>
        </div>
    </section>

    <section class="block">
        <h2>Υλικό @if (_team.Media.Count > 0) { <span class="count">@_team.Media.Count</span> }</h2>
        @if (_team.Media.Count == 0)
        {
            <p class="k-empty">Δεν υπάρχει υλικό ακόμη.</p>
        }
        else
        {
            @* The first photos show; the rest open with "Όλο το υλικό". The lightbox still steps through all of them. *@
            <div class="prints">
                @foreach (TeamMediaDetails media in _team.Media.Take(MediaPreviewCount))
                {
                    @Print(media)
                }
            </div>
            @if (_team.Media.Count > MediaPreviewCount)
            {
                <details class="more-media">
                    <summary>Όλο το υλικό (@_team.Media.Count)</summary>
                    <div class="prints">
                        @foreach (TeamMediaDetails media in _team.Media.Skip(MediaPreviewCount))
                        {
                            @Print(media)
                        }
                    </div>
                </details>
            }
        }
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private const int MediaPreviewCount = 12;

    private TeamProfile? _profile;
    private TeamDetails? _team;
    private List<(string Label, string Url)> _links = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _profile = await GetTeamProfileHandler.HandleAsync(Slug, CancellationToken.None);
            _team = _profile.Team;
        }
        catch (TeamNotFoundException)
        {
            (_profile, _team) = (null, null);
            Navigation.NotFound();
            return;
        }

        _links = new List<(string Label, string? Url)>
            {
                ("Facebook", _team.Facebook),
                ("Instagram", _team.Instagram),
                ("YouTube", _team.Youtube),
                ("Ιστοσελίδα", _team.Website)
            }
            .Where(link => link.Url is not null)
            .Select(link => (link.Label, link.Url!))
            .ToList();
    }

    private static RenderFragment Print(TeamMediaDetails media) =>
        @<a href="/@media.Path" data-gallery="team" aria-label="@media.OriginalFileName">
            <img src="/@media.ThumbnailPath" alt="@media.OriginalFileName" loading="lazy"
                 onerror="this.onerror=null;this.src='/@media.Path'" />
        </a>;
}
