@page "/teams"
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeams
@inject GetTeamsHandler GetTeamsHandler

<PageTitle>Ομάδες</PageTitle>

<header class="k-page-head">
    <div>
        <div class="k-catalogue">Αρχείο</div>
        <h1>Ομάδες</h1>
    </div>
</header>

<SearchForm Action="teams" Search="@Search" Placeholder="Αναζήτηση ομάδας" MaxLength="GetTeamsQuery.SearchMaxLength" />

@if (_page is not null)
{
    @if (_page.Items.Count == 0)
    {
        <p class="k-empty">@(string.IsNullOrWhiteSpace(Search) ? "Δεν υπάρχουν ομάδες." : "Δεν βρέθηκαν ομάδες.")</p>
    }
    else
    {
        <ul class="team-grid">
            @foreach (TeamSummary team in _page.Items)
            {
                <li>
                    <a href="teams/@team.Slug">
                        <TeamFrame Name="@team.Name" Image="@team.Image" Thumbnail="true" />
                        <span class="name">@team.Name</span>
                        @if (!team.IsActive)
                        {
                            <span class="k-stamp muted">Ανενεργή</span>
                        }
                    </a>
                </li>
            }
        </ul>
    }

    <CursorPager BaseUrl="teams" IsFirstPage="_after is null" NextCursor="@_page.NextCursor" Search="@Search" />
}

@code {
    [SupplyParameterFromQuery]
    public string? After { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    private TeamsCursor? _after;
    private TeamsPage? _page;

    protected override async Task OnParametersSetAsync()
    {
        // An invalid or tampered cursor just starts from the beginning.
        _after = TeamsCursor.TryDecode(After, out TeamsCursor? after) ? after : null;
        _page = await GetTeamsHandler.HandleAsync(new GetTeamsQuery(_after, Search), CancellationToken.None);
    }
}
