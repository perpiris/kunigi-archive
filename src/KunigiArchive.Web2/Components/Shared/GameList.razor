@using KunigiArchive.Application.Games
@* A team's games (hosted or won), each linking to its game page. The page leaves out an empty list. *@
<ul class="game-list">
    @foreach (GameSummary game in Games)
    {
        <li>
            <span class="year">@game.Year</span>
            <span>
                <a href="games/@game.Slug"><GameName Order="game.Order" Year="game.Year" /></a>
                @if (game.Title is not null)
                {
                    <em>@game.Title</em>
                }
            </span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<GameSummary> Games { get; set; } = [];
}
