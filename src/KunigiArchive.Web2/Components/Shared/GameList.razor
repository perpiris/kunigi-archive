@using KunigiArchive.Application.Games
@* Plain text until the game pages exist; then each entry links to /games/{slug}. *@
@if (Games.Count == 0)
{
    <p class="k-empty mb-0">@Empty</p>
}
else
{
    <ul class="game-list">
        @foreach (GameSummary game in Games)
        {
            <li>
                <span class="year">@game.Year</span>
                <span>
                    <GameName Order="game.Order" Year="game.Year" />
                    @if (game.Title is not null)
                    {
                        <em>@game.Title</em>
                    }
                </span>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<GameSummary> Games { get; set; } = [];

    [Parameter]
    public string Empty { get; set; } = string.Empty;
}
