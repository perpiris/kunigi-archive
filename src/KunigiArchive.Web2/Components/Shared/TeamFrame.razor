@using KunigiArchive.Application.Media
@* A team's picture as a framed print. Without a picture, a stone-colored card with the team's initial. *@
<div class="team-frame @Class">
    @if (Image is not null)
    {
        string full = "/" + Image;
        string src = Thumbnail ? "/" + MediaRules.ThumbnailFor(Image) : full;
        <img src="@src" alt="@Name" loading="lazy" onerror="this.onerror=null;this.src='@full'" />
    }
    else
    {
        <span aria-hidden="true">@Initial</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Image { get; set; }

    // Lists show the 400px thumbnail; the team page shows the full picture.
    [Parameter]
    public bool Thumbnail { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string Initial => Name.FirstOrDefault(char.IsLetterOrDigit) is char c and not '\0'
        ? char.ToUpper(c, System.Globalization.CultureInfo.GetCultureInfo("el-GR")).ToString()
        : "·";
}
