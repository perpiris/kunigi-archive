@page "/auth/reset-password"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(KunigiArchive.Web.Middleware.RateLimitPolicies.Auth)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Users
@using KunigiArchive.Application.Users.ResetPassword
@using KunigiArchive.Web.Forms.Auth
@inject ResetPasswordHandler ResetPasswordHandler
@inject NavigationManager Navigation

<PageTitle>Νέος κωδικός</PageTitle>

<div class="k-form-page narrow">
    <header class="k-page-head">
        <h1>Νέος κωδικός</h1>
    </header>

    @if (string.IsNullOrWhiteSpace(Form.Email) || string.IsNullOrWhiteSpace(Form.Code))
    {
        <div class="alert alert-danger" role="alert">@ResetPasswordHandler.InvalidLinkMessage</div>
        <p><a href="auth/forgot-password">Νέος σύνδεσμος επαναφοράς</a></p>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">
                @_error
                @if (_linkInvalid)
                {
                    <a href="auth/forgot-password" class="alert-link ms-1">Νέος σύνδεσμος</a>
                }
            </div>
        }

        <p class="text-body-secondary">Ορίστε νέο κωδικό για το <strong>@Form.Email</strong>. @PasswordRules.Message</p>

        <EditForm Model="Form" FormName="reset-password" OnValidSubmit="ResetAsync" Enhance class="k-form">
            <DataAnnotationsValidator />
            <input type="hidden" name="Form.Email" value="@Form.Email" />
            <input type="hidden" name="Form.Code" value="@Form.Code" />
            @* Lets password managers save the new password under the right account. *@
            <input type="email" autocomplete="username" value="@Form.Email" readonly hidden />

            <div class="k-field">
                <label for="password" class="form-label">Νέος κωδικός</label>
                <InputText id="password" type="password" autocomplete="new-password" class="form-control" @bind-Value="Form.Password" />
                <ValidationMessage For="() => Form.Password" />
            </div>

            <div class="k-field mb-0">
                <label for="confirm-password" class="form-label">Επιβεβαίωση κωδικού</label>
                <InputText id="confirm-password" type="password" autocomplete="new-password" class="form-control" @bind-Value="Form.ConfirmPassword" />
                <ValidationMessage For="() => Form.ConfirmPassword" />
            </div>

            <div class="k-form-actions">
                <button type="submit" class="btn btn-primary w-100">Αποθήκευση</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ResetPasswordForm Form { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "email")]
    private string? EmailFromLink { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? CodeFromLink { get; set; }

    private string? _error;
    private bool _linkInvalid;

    protected override void OnInitialized()
    {
        Form ??= new ResetPasswordForm { Email = EmailFromLink ?? string.Empty, Code = CodeFromLink ?? string.Empty };
    }

    private async Task ResetAsync()
    {
        try
        {
            await ResetPasswordHandler.HandleAsync(
                new ResetPasswordCommand(Form.Email, Form.Code, Form.Password), CancellationToken.None);
        }
        catch (InvalidRequestException exception)
        {
            _error = exception.Message;
            _linkInvalid = exception.Message == ResetPasswordHandler.InvalidLinkMessage;
            return;
        }

        Navigation.NavigateTo("auth/login?reset=1");
    }
}
