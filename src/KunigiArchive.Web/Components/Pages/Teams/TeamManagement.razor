@page "/teams/manage"
@attribute [Authorize(Roles = Roles.Admin)]
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeams
@inject GetTeamsHandler GetTeamsHandler

<PageTitle>Διαχείριση ομάδων</PageTitle>

<header class="k-page-head">
    <h1>Διαχείριση ομάδων</h1>
    <a class="btn btn-primary" href="teams/create">Νέα ομάδα</a>
</header>

<SearchForm Action="teams/manage" Search="@Search" Placeholder="Αναζήτηση ομάδας" MaxLength="GetTeamsQuery.SearchMaxLength" />

@if (_page is not null)
{
    @if (_page.Items.Count == 0)
    {
        <p class="text-body-secondary">@(string.IsNullOrWhiteSpace(Search) ? "Δεν υπάρχουν ομάδες." : "Δεν βρέθηκαν ομάδες.")</p>
    }
    else
    {
        <div class="k-table">
        <table class="table align-middle k-sortable">
            <thead>
                <tr>
                    <th>Όνομα</th>
                    <th>Κατάσταση</th>
                    <th class="text-end" data-no-sort>Ενέργειες</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TeamSummary team in _page.Items)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>
                            <span class="badge @(team.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(team.IsActive ? "Ενεργή" : "Ανενεργή")
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="teams/@team.Slug/actions">Ενέργειες</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <CursorPager BaseUrl="teams/manage" IsFirstPage="_after is null" NextCursor="@_page.NextCursor" Search="@Search" />
}

@code {
    [SupplyParameterFromQuery]
    public string? After { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    private TeamsCursor? _after;
    private TeamsPage? _page;

    protected override async Task OnParametersSetAsync()
    {
        _after = TeamsCursor.TryDecode(After, out TeamsCursor? after) ? after : null;
        _page = await GetTeamsHandler.HandleAsync(new GetTeamsQuery(_after, Search, GetTeamsQuery.MaxPageSize), CancellationToken.None);
    }
}
