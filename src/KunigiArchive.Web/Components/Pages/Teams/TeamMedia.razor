@page "/teams/{Slug}/media"
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Manager}")]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Media
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.DeleteTeamMedia
@using KunigiArchive.Application.Teams.GetTeamForEdit
@using KunigiArchive.Application.Teams.UploadTeamMedia
@using KunigiArchive.Domain.Common
@using KunigiArchive.Web.Mappers
@inject GetTeamForEditHandler GetTeamForEditHandler
@inject UploadTeamMediaHandler UploadTeamMediaHandler
@inject DeleteTeamMediaHandler DeleteTeamMediaHandler
@inherits FormPage

<PageTitle>Υλικό ομάδας</PageTitle>

@if (_team is not null)
{
    <header class="k-page-head">
        <h1>@_team.Name</h1>
        <a class="btn btn-outline-secondary" href="teams/@_team.Slug/actions">Ενέργειες ομάδας</a>
    </header>

    @if (_message is not null)
    {
        <div class="alert k-form-alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <form method="post" enctype="multipart/form-data" @formname="upload-media" @onsubmit="UploadAsync" class="k-form mb-4">
        <AntiforgeryToken />
        <h2 class="k-form-title">Υλικό</h2>
        <label for="files" class="form-label">Νέα αρχεία</label>
        <div class="k-inline-form">
            <input id="files" type="file" name="Files" multiple accept="@MediaRules.AcceptAttribute" class="form-control" />
            <button type="submit" class="btn btn-primary">Ανέβασμα</button>
        </div>
        <UploadHint />
    </form>

    <form method="post" @formname="delete-media" @onsubmit="DeleteAsync">
        <AntiforgeryToken />
        <MediaGrid Items="_team.Media.Select(m => new MediaGrid.Item(m.Id, m.Path, m.ThumbnailPath, m.OriginalFileName)).ToList()"
                   Gallery="team-media" />
    </form>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "upload-media")]
    private IReadOnlyList<IFormFile>? Files { get; set; }

    [SupplyParameterFromForm(FormName = "delete-media")]
    private Guid? DeleteMediaId { get; set; }

    private TeamDetails? _team;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task UploadAsync()
    {
        if (_team is null)
        {
            return;
        }

        List<MediaUpload> uploads = (Files ?? []).ToUploads();
        try
        {
            IReadOnlyList<TeamMediaDetails> added = await UploadTeamMediaHandler.HandleAsync(
                new UploadTeamMediaCommand(_team.Id, uploads), CancellationToken.None);
            string uploaded = added.Count == 1 ? "Ανέβηκε 1 αρχείο." : $"Ανέβηκαν {added.Count} αρχεία.";
            Reload(uploaded);
        }
        catch (Exception exception) when (exception is InvalidRequestException or DomainException)
        {
            (_message, _isError) = (exception.Message, true);
        }
        finally
        {
            foreach (MediaUpload upload in uploads)
            {
                await upload.Content.DisposeAsync();
            }
        }

        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_team is null || DeleteMediaId is null)
        {
            return;
        }

        try
        {
            await DeleteTeamMediaHandler.HandleAsync(new DeleteTeamMediaCommand(_team.Id, DeleteMediaId.Value), CancellationToken.None);
            Reload("Το αρχείο διαγράφηκε.");
        }
        catch (DomainException exception)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _team = await GetTeamForEditHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (TeamNotFoundException)
        {
            _team = null;
            Navigation.NotFound();
        }
        catch (ForbiddenException)
        {
            Navigation.NavigateTo("/access-denied");
        }
    }
}
