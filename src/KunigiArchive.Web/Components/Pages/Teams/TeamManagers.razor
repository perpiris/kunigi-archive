@page "/teams/{Slug}/managers"
@attribute [Authorize(Roles = Roles.Admin)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.AssignTeamManager
@using KunigiArchive.Application.Teams.GetTeamManagers
@using KunigiArchive.Application.Teams.RemoveTeamManager
@using KunigiArchive.Application.Users
@using KunigiArchive.Domain.Common
@inject GetTeamManagersHandler GetTeamManagersHandler
@inject AssignTeamManagerHandler AssignTeamManagerHandler
@inject RemoveTeamManagerHandler RemoveTeamManagerHandler
@inherits FormPage

<PageTitle>Διαχειριστές ομάδας</PageTitle>

<div class="k-form-page">

@if (_team is not null)
{
    <header class="k-page-head">
        <h1>@_team.TeamName</h1>
        <a class="btn btn-outline-secondary" href="teams/@_team.Slug/actions">Ενέργειες ομάδας</a>
    </header>

    @if (_message is not null)
    {
        <div class="alert k-form-alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <section class="k-form">
        <h2 class="k-form-title">Διαχειριστές</h2>
        @if (_team.Managers.Count == 0)
        {
            <p class="k-empty mb-0">Η ομάδα δεν έχει διαχειριστές.</p>
        }
        else
        {
            <form method="post" @formname="remove-manager" @onsubmit="RemoveAsync">
                <AntiforgeryToken />
                <ul class="list-group">
                    @foreach (UserSummary manager in _team.Managers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <span class="text-truncate">@manager.Email</span>
                            <button type="submit" name="RemoveUserId" value="@manager.Id" class="btn btn-sm btn-outline-danger"
                                    data-confirm="Αφαίρεση του διαχειριστή από την ομάδα;">
                                Αφαίρεση
                            </button>
                        </li>
                    }
                </ul>
            </form>
        }
    </section>

    <section class="k-form">
        <h2 class="k-form-title">Προσθήκη διαχειριστή</h2>
        @if (_team.AvailableManagers.Count == 0)
        {
            <p class="k-empty mb-0">
                Δεν υπάρχουν άλλοι χρήστες με ρόλο διαχειριστή ομάδας. <a href="users/create">Νέος χρήστης</a>
            </p>
        }
        else
        {
            <form method="post" @formname="add-manager" @onsubmit="AddAsync">
                <AntiforgeryToken />
                <label for="add-user" class="form-label">Χρήστης</label>
                <div class="k-inline-form">
                    <k-combobox placeholder="Πληκτρολογήστε email">
                        <select id="add-user" name="AddUserId" class="form-select">
                            @foreach (UserSummary user in _team.AvailableManagers)
                            {
                                <option value="@user.Id">@user.Email</option>
                            }
                        </select>
                    </k-combobox>
                    <button type="submit" class="btn btn-primary">Προσθήκη</button>
                </div>
            </form>
        }
    </section>
}

</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "add-manager")]
    private Guid? AddUserId { get; set; }

    [SupplyParameterFromForm(FormName = "remove-manager")]
    private Guid? RemoveUserId { get; set; }

    private TeamManagersDetails? _team;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        if (_team is null || AddUserId is null)
        {
            return;
        }

        await RunAsync(
            () => AssignTeamManagerHandler.HandleAsync(new AssignTeamManagerCommand(_team.TeamId, AddUserId.Value), CancellationToken.None),
            "Ο διαχειριστής προστέθηκε.");
    }

    private async Task RemoveAsync()
    {
        if (_team is null || RemoveUserId is null)
        {
            return;
        }

        await RunAsync(
            () => RemoveTeamManagerHandler.HandleAsync(new RemoveTeamManagerCommand(_team.TeamId, RemoveUserId.Value), CancellationToken.None),
            "Ο διαχειριστής αφαιρέθηκε.");
    }

    private async Task RunAsync(Func<Task> action, string successMessage)
    {
        try
        {
            await action();
            Reload(successMessage);
        }
        catch (Exception exception) when (exception is DomainException or ConflictException)
        {
            (_message, _isError) = (exception.Message, true);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _team = await GetTeamManagersHandler.HandleAsync(Slug, CancellationToken.None);
        }
        catch (TeamNotFoundException)
        {
            _team = null;
            Navigation.NotFound();
        }
    }
}
