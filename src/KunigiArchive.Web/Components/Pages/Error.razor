@page "/Error"
@using System.Diagnostics

<PageTitle>Σφάλμα</PageTitle>

<h1 class="text-danger">Σφάλμα</h1>
<p>Παρουσιάστηκε ένα απρόσμενο σφάλμα κατά την επεξεργασία του αιτήματος.</p>

@if (ShowRequestId)
{
    <p class="text-body-secondary small">Κωδικός αιτήματος: <code>@RequestId</code></p>
}

<a class="btn btn-outline-secondary" href="">Αρχική</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
