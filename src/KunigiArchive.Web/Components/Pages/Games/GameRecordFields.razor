@using KunigiArchive.Application.Teams
@using KunigiArchive.Web.Forms.Games
@* The admin's fields for a game, shared by "Νέο παιχνίδι" and "Διόρθωση στοιχείων".
   Title, note, poster and the rest are filled in by the host team's managers. *@

<div class="k-field-row">
    <div class="k-field short">
        <label for="year" class="form-label">Χρονιά</label>
        <InputNumber id="year" class="form-control" inputmode="numeric" @bind-Value="Form.Year" />
        <ValidationMessage For="() => Form.Year" />
    </div>
    <div class="k-field short">
        <label for="order" class="form-label">Αριθμός</label>
        <InputText id="order" class="form-control" inputmode="decimal" placeholder="34 ή 31,5" @bind-Value="Form.Order" />
        <ValidationMessage For="() => Form.Order" />
    </div>
</div>
<p class="form-text mt-n2 mb-3">Χωρίς αριθμό για παιχνίδι εκτός αρίθμησης, όπως «Το Ξεκίνημα» του 1988.</p>

<div class="k-field-row">
    <div class="k-field">
        <label for="host" class="form-label">Διοργάνωση</label>
        <k-combobox>
            <InputSelect id="host" class="form-select" @bind-Value="Form.HostId">
                <option value="">Χωρίς ομάδα</option>
                @foreach (TeamOption team in Teams)
                {
                    <option value="@team.Id">@Label(team)</option>
                }
            </InputSelect>
        </k-combobox>
    </div>
    <div class="k-field">
        <label for="winner" class="form-label">Νικητής</label>
        <k-combobox>
            <InputSelect id="winner" class="form-select" @bind-Value="Form.WinnerId">
                <option value="">Χωρίς ομάδα</option>
                @foreach (TeamOption team in Teams)
                {
                    <option value="@team.Id">@Label(team)</option>
                }
            </InputSelect>
        </k-combobox>
    </div>
</div>
<p class="form-text mt-n2 mb-0">Λείπει μια ομάδα; <a href="teams/create">Δημιουργήστε την</a> πρώτα.</p>

@code {
    [Parameter, EditorRequired]
    public GameRecordForm Form { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<TeamOption> Teams { get; set; } = [];

    private static string Label(TeamOption team)
    {
        return team.IsActive ? team.Name : $"{team.Name} (ανενεργή)";
    }
}
