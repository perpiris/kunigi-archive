@page "/games/{Id:guid}/edit"
@attribute [Authorize(Roles = Roles.Admin)]
@using KunigiArchive.Application.Abstractions.Exceptions
@using KunigiArchive.Application.Games
@using KunigiArchive.Application.Games.GetGameRecord
@using KunigiArchive.Application.Games.UpdateGameRecord
@using KunigiArchive.Application.Teams
@using KunigiArchive.Application.Teams.GetTeamOptions
@using KunigiArchive.Domain.Common
@using KunigiArchive.Web.Forms.Games
@using KunigiArchive.Web.Mappers
@inject GetGameRecordHandler GetGameRecordHandler
@inject UpdateGameRecordHandler UpdateGameRecordHandler
@inject GetTeamOptionsHandler GetTeamOptionsHandler
@inherits FormPage

<PageTitle>Στοιχεία παιχνιδιού</PageTitle>

<div class="k-form-page">

@if (_game is not null)
{
    <header class="k-page-head">
        <h1><GameName Order="_game.Order" Year="_game.Year" /></h1>
        <a class="btn btn-outline-secondary" href="games/@_game.Slug/actions">Ενέργειες παιχνιδιού</a>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-danger k-form-alert" role="alert">@_error</div>
    }

    <EditForm Model="Form" FormName="edit-game" OnValidSubmit="SaveAsync" Enhance class="k-form">
        <DataAnnotationsValidator />

        <GameRecordFields Form="Form" Teams="_teams" />

        <div class="k-form-actions">
            <a class="btn btn-outline-secondary" href="games/@_game.Slug/actions">Ακύρωση</a>
            <button type="submit" class="btn btn-primary">Αποθήκευση</button>
        </div>
    </EditForm>
}

</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm]
    private GameRecordForm? Form { get; set; }

    private GameRecord? _game;
    private IReadOnlyList<TeamOption> _teams = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _game = await GetGameRecordHandler.HandleAsync(Id, CancellationToken.None);
        }
        catch (GameNotFoundException)
        {
            Navigation.NotFound();
            return;
        }

        Form ??= _game.ToForm();
        _teams = await GetTeamOptionsHandler.HandleAsync(CancellationToken.None);
    }

    private async Task SaveAsync()
    {
        GameSummary game;
        try
        {
            // The game comes from the route, not from the posted form.
            GameRecordForm form = Form! with { Id = Id };
            game = await UpdateGameRecordHandler.HandleAsync(form.ToUpdateCommand(), CancellationToken.None);
        }
        catch (Exception exception) when (exception is DomainException or ConflictException or InvalidRequestException)
        {
            _error = exception.Message;
            return;
        }

        // The slug follows the number, so the address comes from the saved game.
        Done("Τα στοιχεία αποθηκεύτηκαν.", $"/games/{game.Slug}/actions");
    }
}
