@model KunigiArchive.Web.ViewModels.Account.AccountCreateViewModel

@{
    ViewData["Title"] = "Δημιουργία νέου χρήστη";
    ViewData["Banner"] = "Δημιουργία νέου χρήστη";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 mt-2 p-2">
            <div class="card-body p-4">
                <form id="createUserForm" asp-controller="Account" asp-action="AccountCreate" method="post"
                      autocomplete="off">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedRole" class="form-label fw-semibold d-block"></label>
                        @foreach (var role in Model.RolesList)
                        {
                            <div class="form-check form-check-inline">
                                <input asp-for="SelectedRole" type="radio" value="@role.Value" class="form-check-input"
                                       id="role-@role.Value"/>
                                <label class="form-check-label" for="role-@role.Value">@role.Text</label>
                            </div>
                        }
                        <span asp-validation-for="SelectedRole" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-controller="Account" asp-action="AccountManagement" class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}