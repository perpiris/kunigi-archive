@model KunigiArchive.Web.ViewModels.Game.PostCreateViewModel

@{
    ViewData["Title"] = "Νέα Ανάρτηση";
    ViewData["Banner"] = "Νέα Ανάρτηση";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 mt-2">
            <div class="card-body p-4">
                <form asp-controller="Game" asp-action="CreatePost" method="post"
                      autocomplete="off" id="post-form">
                    <input type="hidden" asp-for="GameId"/>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold"></label>
                        <input asp-for="Content" type="hidden"/>
                        <div id="editor-container" style="height: 400px;">@Html.RichText(Model.Content)</div>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Game" asp-action="ManagePosts"
                           asp-route-slug="@ViewContext.RouteData.Values["slug"]"
                           class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css"/>
    <script src="~/lib/quill/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{'header': 1}, {'header': 2}],
                        [{'list': 'ordered'}, {'list': 'bullet'}],
                        [{'indent': '-1'}, {'indent': '+1'}],
                        [{'direction': 'rtl'}],
                        [{'size': ['small', false, 'large', 'huge']}],
                        [{'color': []}, {'background': []}],
                        [{'align': []}],
                        ['clean'],
                        ['link', 'image', 'video']
                    ]
                }
            });

            let form = document.querySelector('#post-form');
            let contentInput = form.querySelector('input[name="Content"]');

            form.addEventListener('submit', function () {
                let html = quill.root.innerHTML;
                contentInput.value = (html === '<p><br></p>') ? '' : html;
            });
        });
    </script>
}
