@model KunigiArchive.Web.ViewModels.Game.PuzzleEditViewModel

@{
    ViewData["Title"] = "Επεξεργασία Γρίφου";
    ViewData["Banner"] = "Επεξεργασία Γρίφου";
}

@functions {
    static bool IsVideo(string fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return false;
        string[] videoExtensions = [".mp4", ".mov", ".webm", ".mkv", ".avi", ".wmv"];
        return videoExtensions.Any(ext => fileName.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
    }

    static string GetThumbnailPath(string path)
    {
        var lastSlash = path.LastIndexOf('/');
        if (lastSlash < 0) return path;
        return $"{path[..(lastSlash + 1)]}thumb_{path[(lastSlash + 1)..]}";
    }
}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 mt-2">
            <div class="card-body p-4">
                <form asp-controller="Game" asp-action="EditPuzzle" method="post" enctype="multipart/form-data"
                      autocomplete="off" id="puzzle-form">
                    <input type="hidden" asp-for="PuzzleId"/>
                    <input type="hidden" asp-for="GameDayId"/>

                    <div class="accordion" id="puzzleAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#questionSection" aria-expanded="true">
                                    Ερώτηση
                                </button>
                            </h2>
                            <div id="questionSection" class="accordion-collapse collapse show"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Κείμενο Ερώτησης</label>
                                        <input asp-for="Question" type="hidden"/>
                                        <div id="question-editor" style="height: 250px;">@Html.RichText(Model.Question)</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Αρχεία Ερώτησης</label>
                                        @if (Model.QuestionMedia.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                @foreach (var item in Model.QuestionMedia)
                                                {
                                                    <div class="position-relative border rounded p-1" style="width: 120px;">
                                                        @if (IsVideo(item.FileName))
                                                        {
                                                            <video class="w-100" style="height: 80px; object-fit: cover;">
                                                                <source src="~/@item.Path" type="video/mp4">
                                                            </video>
                                                        }
                                                        else
                                                        {
                                                            <img src="~/@GetThumbnailPath(item.Path)" class="w-100" style="height: 80px; object-fit: cover;" alt="@item.FileName">
                                                        }
                                                        <button type="submit" form="delete-media-form" 
                                                                formaction="/games/@ViewContext.RouteData.Values["slug"]/day/@Model.GameDayId/puzzles/@Model.PuzzleId/media/@item.MediaFileId/delete" 
                                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-0 d-flex align-items-center justify-content-center" 
                                                                style="width: 24px; height: 24px; z-index: 10;" 
                                                                onclick="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το αρχείο;');"
                                                                title="Διαγραφή">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <input type="file" name="QuestionMediaFiles" class="form-control" multiple/>
                                        <div class="form-text">
                                            Τα νέα αρχεία θα προστεθούν στα υπάρχοντα.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#answerSection">
                                    Απάντηση
                                </button>
                            </h2>
                            <div id="answerSection" class="accordion-collapse collapse"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Κείμενο Απάντησης</label>
                                        <input asp-for="Answer" type="hidden"/>
                                        <div id="answer-editor" style="height: 250px;">@Html.RichText(Model.Answer)</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Αρχεία Απάντησης</label>
                                        @if (Model.AnswerMedia.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                @foreach (var item in Model.AnswerMedia)
                                                {
                                                    <div class="position-relative border rounded p-1" style="width: 120px;">
                                                        @if (IsVideo(item.FileName))
                                                        {
                                                            <video class="w-100" style="height: 80px; object-fit: cover;">
                                                                <source src="~/@item.Path" type="video/mp4">
                                                            </video>
                                                        }
                                                        else
                                                        {
                                                            <img src="~/@GetThumbnailPath(item.Path)" class="w-100" style="height: 80px; object-fit: cover;" alt="@item.FileName">
                                                        }
                                                        <button type="submit" form="delete-media-form" 
                                                                formaction="/games/@ViewContext.RouteData.Values["slug"]/day/@Model.GameDayId/puzzles/@Model.PuzzleId/media/@item.MediaFileId/delete" 
                                                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-0 d-flex align-items-center justify-content-center" 
                                                                style="width: 24px; height: 24px; z-index: 10;" 
                                                                onclick="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το αρχείο;');"
                                                                title="Διαγραφή">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <input type="file" name="AnswerMediaFiles" class="form-control" multiple/>
                                        <div class="form-text">
                                            Τα νέα αρχεία θα προστεθούν στα υπάρχοντα.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#settingsSection">
                                    Ρυθμίσεις
                                </button>
                            </h2>
                            <div id="settingsSection" class="accordion-collapse collapse"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label asp-for="Group" class="form-label fw-semibold">Πακέτο</label>
                                        <input asp-for="Group" type="number" class="form-control" min="0"
                                               placeholder="Προαιρετικό — αριθμός πακέτου"/>
                                        <div class="form-text">
                                            Γρίφοι με τον ίδιο αριθμό πακέτου ομαδοποιούνται μαζί. Βάλτε 0 ή αφήστε
                                            κενό για να αφαιρέσετε από πακέτο.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Game" asp-action="ManagePuzzles"
                           asp-route-slug="@ViewContext.RouteData.Values["slug"]"
                           asp-route-gameDayId="@Model.GameDayId"
                           class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<form id="delete-media-form" method="post" style="display:none;"></form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css"/>
    <script src="~/lib/quill/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toolbarOptions = [
                ['bold', 'italic', 'underline', 'strike'],
                [{'list': 'ordered'}, {'list': 'bullet'}],
                [{'color': []}, {'background': []}],
                [{'align': []}],
                ['clean'],
                ['link', 'image']
            ];

            let questionQuill = new Quill('#question-editor', {
                theme: 'snow',
                modules: {toolbar: toolbarOptions}
            });

            let answerQuill = new Quill('#answer-editor', {
                theme: 'snow',
                modules: {toolbar: toolbarOptions}
            });

            let form = document.querySelector('#puzzle-form');
            let questionInput = form.querySelector('input[name="Question"]');
            let answerInput = form.querySelector('input[name="Answer"]');

            form.addEventListener('submit', function () {
                let qHtml = questionQuill.root.innerHTML;
                questionInput.value = (qHtml === '<p><br></p>') ? '' : qHtml;

                let aHtml = answerQuill.root.innerHTML;
                answerInput.value = (aHtml === '<p><br></p>') ? '' : aHtml;
            });
        });
    </script>
}
