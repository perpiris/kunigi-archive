@model KunigiArchive.Web.ViewModels.Game.PuzzleCreateViewModel

@{
    ViewData["Title"] = "Νέος Γρίφος";
    ViewData["Banner"] = "Νέος Γρίφος";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 mt-2">
            <div class="card-body p-4">
                <form asp-controller="Game" asp-action="CreatePuzzle" method="post" enctype="multipart/form-data"
                      autocomplete="off" id="puzzle-form">
                    <input type="hidden" asp-for="GameDayId"/>

                    <div class="accordion" id="puzzleAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#questionSection" aria-expanded="true">
                                    Ερώτηση
                                </button>
                            </h2>
                            <div id="questionSection" class="accordion-collapse collapse show"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Κείμενο Ερώτησης</label>
                                        <input asp-for="Question" type="hidden"/>
                                        <div id="question-editor" style="height: 250px;">@Html.RichText(Model.Question)</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Αρχεία Ερώτησης</label>
                                        <input type="file" name="QuestionMediaFiles" class="form-control" multiple/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#answerSection">
                                    Απάντηση
                                </button>
                            </h2>
                            <div id="answerSection" class="accordion-collapse collapse"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Κείμενο Απάντησης</label>
                                        <input asp-for="Answer" type="hidden"/>
                                        <div id="answer-editor" style="height: 250px;">@Html.RichText(Model.Answer)</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Αρχεία Απάντησης</label>
                                        <input type="file" name="AnswerMediaFiles" class="form-control" multiple/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#settingsSection">
                                    Ρυθμίσεις
                                </button>
                            </h2>
                            <div id="settingsSection" class="accordion-collapse collapse"
                                 data-bs-parent="#puzzleAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">
                                        <label asp-for="Group" class="form-label fw-semibold">Πακέτο</label>
                                        <input asp-for="Group" type="number" class="form-control" min="0"
                                               placeholder="Προαιρετικό — αριθμός πακέτου"/>
                                        <div class="form-text">
                                            Γρίφοι με τον ίδιο αριθμό πακέτου ομαδοποιούνται μαζί.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Game" asp-action="ManagePuzzles"
                           asp-route-slug="@ViewContext.RouteData.Values["slug"]"
                           asp-route-gameDayId="@Model.GameDayId"
                           class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css"/>
    <script src="~/lib/quill/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toolbarOptions = [
                ['bold', 'italic', 'underline', 'strike'],
                [{'list': 'ordered'}, {'list': 'bullet'}],
                [{'color': []}, {'background': []}],
                [{'align': []}],
                ['clean'],
                ['link', 'image']
            ];

            let questionQuill = new Quill('#question-editor', {
                theme: 'snow',
                modules: {toolbar: toolbarOptions}
            });

            let answerQuill = new Quill('#answer-editor', {
                theme: 'snow',
                modules: {toolbar: toolbarOptions}
            });

            let form = document.querySelector('#puzzle-form');
            let questionInput = form.querySelector('input[name="Question"]');
            let answerInput = form.querySelector('input[name="Answer"]');

            form.addEventListener('submit', function () {
                let qHtml = questionQuill.root.innerHTML;
                questionInput.value = (qHtml === '<p><br></p>') ? '' : qHtml;

                let aHtml = answerQuill.root.innerHTML;
                answerInput.value = (aHtml === '<p><br></p>') ? '' : aHtml;
            });
        });
    </script>
}
