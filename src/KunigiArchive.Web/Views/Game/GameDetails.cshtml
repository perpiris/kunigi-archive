@model KunigiArchive.Web.ViewModels.Game.GameDetailsViewModel

@{
    ViewData["Title"] = Model.FormattedTitle();
}

<div class="row gx-lg-5 gy-4 mb-5 align-items-center">
    <div class="col-md-5">
        <div class="position-relative">
            @if (string.IsNullOrEmpty(Model.Image))
            {
                <div class="ratio ratio-1x1 border border-2 border-ink bg-surface">
                    <div class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-compass display-1 opacity-25"></i>
                    </div>
                </div>
            }
            else
            {
                <img src="~/@Model.Image" class="img-fluid w-100 border border-2 border-ink rounded-0"
                     alt="@Model.FormattedTitle()">
            }
        </div>
    </div>

    <div class="col-md-7">
        <h1 class="display-2 fw-bold text-uppercase mb-2 text-break">@Model.OrderTitle</h1>

        <div class="fs-4 font-monospace mb-4 border-bottom border-2 border-ink pb-3 d-inline-block">
            <span class="fw-bold">@Model.Year</span>
            @if (!string.IsNullOrWhiteSpace(Model.Title))
            {
                <span class="mx-2 opacity-50">/</span>
                <span class="fw-bold">@Model.Title</span>
            }
        </div>

        <div class="d-flex flex-column gap-2 fs-5">
            @if (!string.IsNullOrEmpty(Model.Host))
            {
                <div>
                    <span class="text-muted">Διοργάνωση:</span>
                    <a asp-controller="Team" asp-action="TeamDetails" asp-route-slug="@Model.HostSlug"
                       class="fw-bold text-decoration-none text-body">
                        @Model.Host
                    </a>
                </div>
            }
            <div>
                <span class="text-muted">Νικητής:</span>
                @if (!string.IsNullOrEmpty(Model.Winner) && !string.IsNullOrEmpty(Model.WinnerSlug))
                {
                    <a asp-controller="Team" asp-action="TeamDetails" asp-route-slug="@Model.WinnerSlug"
                       class="fw-bold text-decoration-none text-body">
                        @Model.Winner
                    </a>
                }
                else
                {
                    <span class="fw-bold">??????</span>
                }
            </div>
        </div>
    </div>
</div>

<hr class="border-2 border-ink opacity-100 mb-5"/>

<div class="row gy-5">
    <div class="col-12">
        <h2 class="fw-bold text-uppercase mb-3">Περιγραφή</h2>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="fs-5 lh-lg">
                @Html.RichText(Model.Description)
            </div>
        }
        else
        {
            <p class="text-muted fst-italic">Δεν υπάρχει περιγραφή διαθέσιμη.</p>
        }
    </div>

    @if (Model.GameDays.Any())
    {
        <div class="col-12">
            <h2 class="fw-bold text-uppercase mb-3">Ημέρες</h2>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var day in Model.GameDays)
                {
                    <a asp-controller="Game" asp-action="GameDayDetails"
                       asp-route-slug="@Model.Slug" asp-route-id="@day.GameDayId"
                       class="btn btn-outline-dark fw-bold px-4">
                        @day.Name
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Posts.Any())
    {
        <div class="col-12">
            <h2 class="fw-bold text-uppercase mb-3">Αναρτήσεις</h2>
            <div class="accordion" id="postAccordion">
                @foreach (var post in Model.Posts)
                {
                    var collapseId = $"post-{post.PostId}";
                    <div class="accordion-item border-2 border-ink">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-semibold" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                @if (!string.IsNullOrWhiteSpace(post.Title))
                                {
                                    @post.Title <text>-</text>
                                }
                                @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse"
                             data-bs-parent="#postAccordion">
                            <div class="accordion-body fs-5 lh-lg ql-editor px-3">
                                @Html.RichText(post.Content)
                                @if (post.Media != null && post.Media.Any())
                                {
                                    <div class="mt-4">
                                        @await Html.PartialAsync("_MediaGallery", post.Media)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Media.Any())
    {
        <div class="col-12">
            <h2 class="fw-bold text-uppercase mb-4">Υλικό</h2>
            @await Html.PartialAsync("_MediaGallery", Model.Media)
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}
