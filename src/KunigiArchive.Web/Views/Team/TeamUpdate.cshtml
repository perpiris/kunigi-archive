@model KunigiArchive.Web.ViewModels.Team.TeamUpdateViewModel

@{
    ViewData["Title"] = $"Επεξεργασία Ομάδας: {Model.Name}";
    ViewData["Banner"] = Model.Name;
    var isAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 mt-2">
            <div class="card-body p-4">
                <form asp-controller="Team" asp-action="TeamUpdate" method="post" autocomplete="off"
                      enctype="multipart/form-data" id="update-team-form">
                    <input type="hidden" asp-for="TeamId"/>
                    <input type="hidden" asp-for="Name"/>
                    <input type="hidden" asp-for="Slug"/>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <input asp-for="Description" type="hidden"/>
                        <div id="editor-container" style="height: 400px;">@Html.RichText(Model.Description)</div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="accordion" id="teamAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#basicSettings" aria-expanded="true">
                                    Βασικές Ρυθμίσεις
                                </button>
                            </h2>
                            <div id="basicSettings" class="accordion-collapse collapse show"
                                 data-bs-parent="#teamAccordion">
                                <div class="accordion-body">
                                    <div class="row align-items-end">
                                        @if (isAdmin)
                                        {
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label asp-for="UpdatedSlug" class="form-label fw-semibold"></label>
                                                    <input asp-for="UpdatedSlug" class="form-control"/>
                                                    <span asp-validation-for="UpdatedSlug"
                                                          class="text-danger small"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label asp-for="UpdatedName" class="form-label fw-semibold"></label>
                                                    <input asp-for="UpdatedName" class="form-control"/>
                                                    <span asp-validation-for="UpdatedName"
                                                          class="text-danger small"></span>
                                                </div>
                                            </div>
                                        }
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label asp-for="YearFounded" class="form-label fw-semibold"></label>
                                                <input asp-for="YearFounded" class="form-control" type="number"
                                                       pattern="\d{4}" maxlength="4"
                                                       oninput="this.value = this.value.slice(0,4)"/>
                                                <span asp-validation-for="YearFounded" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Κατάσταση</label>
                                                <div class="d-flex align-items-center" style="min-height: 38px;">
                                                    <div class="form-check form-switch me-4">
                                                        <input asp-for="IsActive" class="form-check-input"
                                                               type="checkbox" role="switch"/>
                                                        <label class="form-check-label" asp-for="IsActive"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="mb-3">
                                                <label asp-for="Image" class="form-label fw-semibold"></label>
                                                <input asp-for="Image" class="form-control" type="file"
                                                       accept="image/jpeg, image/png"/>
                                                <span asp-validation-for="Image" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Social Media -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#socialMedia">
                                    Μέσα Κοινωνικής Δικτύωσης
                                </button>
                            </h2>
                            <div id="socialMedia" class="accordion-collapse collapse" data-bs-parent="#teamAccordion">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Facebook" class="form-label fw-semibold"></label>
                                                <input asp-for="Facebook" class="form-control"/>
                                                <span asp-validation-for="Facebook" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Instagram" class="form-label fw-semibold"></label>
                                                <input asp-for="Instagram" class="form-control"/>
                                                <span asp-validation-for="Instagram" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Youtube" class="form-label fw-semibold"></label>
                                                <input asp-for="Youtube" class="form-control"/>
                                                <span asp-validation-for="Youtube" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Website" class="form-label fw-semibold"></label>
                                                <input asp-for="Website" class="form-control"/>
                                                <span asp-validation-for="Website" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Team" asp-action="TeamActions" asp-route-slug="@Model.Slug"
                           class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css"/>
    <script src="~/lib/quill/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{'header': 1}, {'header': 2}],
                        [{'list': 'ordered'}, {'list': 'bullet'}],
                        [{'indent': '-1'}, {'indent': '+1'}],
                        [{'direction': 'rtl'}],
                        [{'size': ['small', false, 'large', 'huge']}],
                        [{'color': []}, {'background': []}],
                        [{'align': []}],
                        ['clean'],
                        ['link', 'image', 'video']
                    ]
                }
            });

            let form = document.querySelector('#update-team-form');
            let descriptionInput = form.querySelector('input[name="Description"]');

            form.addEventListener('submit', function (e) {
                let html = quill.root.innerHTML;
                descriptionInput.value = (html === '<p><br></p>') ? '' : html;
            });
        });
    </script>
}