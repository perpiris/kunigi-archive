@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Team.TeamDetailsViewModel>

@{
    ViewData["Title"] = "Ομάδες";
    var searchQuery = (string?)(ViewBag.SearchQuery ?? "");
    var pageNav = new KunigiArchive.Web.ViewModels.Common.PageNavViewModel
    {
        Controller = "Team",
        Action = "TeamList",
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        SearchQuery = searchQuery
    };
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h6 class="text-uppercase text-muted mb-2">Οι παρέες πίσω από το κυνήγι</h6>
        <h1 class="display-4 fw-bold mb-0">
            Οι Ομάδες
        </h1>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <partial name="_SearchForm" model="pageNav"/>
    </div>
</div>

<hr class="border-2 border-ink opacity-100 mb-5"/>

@if (Model.Items.Any())
{
    <div class="row g-4">
        @foreach (var team in Model.Items)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 clickable-card">
                    <div class="card-header d-flex align-items-center justify-content-center py-2"
                         style="min-height: 3.5rem;">
                        <h6 class="fw-bold text-uppercase mb-0 small text-center">@team.Name</h6>
                    </div>

                    <div class="card-thumb">
                        @if (string.IsNullOrEmpty(team.Image))
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-people fs-1 opacity-25"></i>
                            </div>
                        }
                        else
                        {
                            <img src="~/@Url.Content(team.Image)" alt="@team.Name">
                        }
                    </div>

                    <a asp-controller="Team"
                       asp-action="TeamDetails"
                       asp-route-slug="@team.Slug"
                       class="stretched-link"
                       aria-label="Προβολή: @team.Name"></a>
                </div>
            </div>
        }
    </div>

    <partial name="_Pagination" model="pageNav"/>
}
else
{
    <div class="text-center py-5 border border-2 border-ink">
        <i class="bi bi-binoculars display-1 opacity-25 d-block mb-3"></i>
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <a asp-controller="Team" asp-action="TeamList" class="btn btn-secondary mt-3">Καθαρισμός Φίλτρων</a>
        }
    </div>
}
