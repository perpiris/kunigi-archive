@model IEnumerable<KunigiArchive.Web.ViewModels.Team.TeamDetailsViewModel>

@{
    ViewData["Title"] = "Οι Ομάδες μου";
    ViewData["Banner"] = "Οι Ομάδες μου";
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
            <tr>
                <th scope="col">Όνομα Ομάδας</th>
                <th scope="col" class="text-end">Ενέργειες</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var team in Model)
            {
                <tr>
                    <td class="align-middle">@team.Name</td>
                    <td class="text-end align-middle">
                        <a asp-controller="Team" asp-action="TeamActions" asp-route-slug="@team.Slug"
                           class="btn btn-secondary btn-sm">Ενέργειες</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5 border border-2 border-ink">
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
    </div>
}
