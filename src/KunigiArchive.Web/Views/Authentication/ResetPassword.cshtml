@model KunigiArchive.Web.ViewModels.Authentication.ResetPasswordViewModel

@{
    ViewData["Title"] = "Ορισμός νέου κωδικού";
    ViewData["Banner"] = "Νέος Κωδικός";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card auth-card mt-2 p-2">
            <div class="card-body p-4">
                <form asp-controller="Authentication" asp-action="ResetPassword" method="post">
                    <input asp-for="Email" type="hidden"/>
                    <input asp-for="Token" type="hidden"/>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Νέος κωδικός</label>
                        <input asp-for="Password" class="form-control" type="password"/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Επιβεβαίωση κωδικού</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password"/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-controller="Authentication" asp-action="Login" class="text-decoration-none">Επιστροφή
                            στη σύνδεση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}