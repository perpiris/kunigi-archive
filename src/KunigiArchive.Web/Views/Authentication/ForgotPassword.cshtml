@model KunigiArchive.Web.ViewModels.Authentication.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Επαναφορά κωδικού";
    ViewData["Banner"] = "Επαναφορά Κωδικού";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card auth-card mt-2 p-2">
            <div class="card-body p-4">
                <form asp-controller="Authentication" asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Αποστολή</button>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none">Επιστροφή στη σύνδεση</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}