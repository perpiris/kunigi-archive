@model List<KunigiArchive.Web.ViewModels.Common.MediaFileViewModel>

<link rel="stylesheet" href="~/lib/fancybox/fancybox.css"/>

<div class="media-gallery">
    @foreach (var item in Model)
    {
        var mediaType = GetMediaType(item.FileName);
        var mediaPath = Url.Content($"~/{item.Path}");

        @if (mediaType == "image")
        {
            <a href="@mediaPath"
               data-fancybox="gallery"
               class="media-item">
                <div class="media-thumbnail">
                    <img src="@GetThumbnailPath(mediaPath)" alt="@item.FileName" loading="lazy"/>
                </div>
            </a>
        }
        else if (mediaType == "video")
        {
            <a href="@mediaPath"
               data-fancybox="gallery"
               class="media-item">
                <div class="media-thumbnail video-thumb">
                    <video preload="metadata" muted>
                        <source src="@mediaPath" type="video/mp4">
                    </video>
                    <div class="play-overlay">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>
                </div>
            </a>
        }
    }
</div>

<script src="~/lib/fancybox/fancybox.umd.js"></script>

<script>
    Fancybox.bind("[data-fancybox='gallery']", {
        Carousel: {
            Thumbs: false,
        },
    });
</script>

@functions {

    static string GetMediaType(string fileName)
    {
        var extension = fileName[(fileName.LastIndexOf('.') + 1)..].ToLowerInvariant();
        return extension switch
        {
            "jpg" or "jpeg" or "png" or "gif" or "bmp" or "svg" or "webp" => "image",
            "mp4" or "avi" or "mov" or "wmv" or "webm" => "video",
            _ => "unknown"
        };
    }

    static string GetThumbnailPath(string path)
    {
        var lastSlash = path.LastIndexOf('/');
        if (lastSlash < 0) return path;
        return $"{path[..(lastSlash + 1)]}thumb_{path[(lastSlash + 1)..]}";
    }

}