@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Team.TeamDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση Ομάδων";
    var searchQuery = ViewBag.SearchQuery ?? "";
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h1 class="display-4 mb-2">
            Διαχείριση Ομάδων
        </h1>
        <a href="@Url.Action("TeamCreate", "Team")" class="btn btn-primary">Νέα Ομάδα</a>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <form asp-controller="Team" asp-action="TeamManagement" method="get">
            <input type="hidden" name="pageNumber" value="1"/>
            <input type="hidden" name="pageSize" value="@Model.PageSize"/>

            <label class="form-label fw-bold text-uppercase small">Αναζήτησε μία ομάδα</label>
            <div class="input-group">
                <input type="text"
                       name="searchQuery"
                       value="@searchQuery"
                       class="form-control"
                       placeholder="..."
                       aria-label="Search">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>

                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a asp-controller="Team" asp-action="TeamManagement" class="btn btn-danger" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="list-group">
        @foreach (var team in Model.Items)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span>@team.Name</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Team" asp-action="TeamActions" asp-route-slug="@team.Slug"
                       class="btn btn-secondary">Ενέργειες</a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-team-name="@team.Name" data-team-slug="@team.Slug">
                        Διαγραφή
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 border border-2 border-dark">
        <h3 class="fw-bold text-uppercase">No Results Found</h3>
        <p class="text-muted">Try adjusting your search query.</p>
        <a asp-action="TeamManagement" class="btn btn-secondary mt-3">Reset Filters</a>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="mt-5 pt-3 border-top border-2 border-dark">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center m-0">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &lt;&lt;
                    </a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchQuery="@searchQuery">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &gt;&gt;
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}


<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Επιβεβαίωση Διαγραφής
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" role="alert">
                    <h6 class="alert-heading">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Προσοχή!
                    </h6>
                    <p class="mb-0">
                        Είστε σίγουροι ότι θέλετε να διαγράψετε την ομάδα <strong id="teamNameDisplay"></strong>;
                    </p>
                </div>
                <p class="mb-2">Αυτή η ενέργεια θα διαγράψει:</p>
                <ul class="mb-0">
                    <li>Όλα τα στοιχεία της ομάδας</li>
                    <li>Όλους τους διαχειριστές της ομάδας</li>
                    <li>Όλα τα αρχεία πολυμέσων</li>
                    <li>Τον φάκελο αποθήκευσης</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ακύρωση</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-2"></i>
                        Διαγραφή
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteModal');
            const deleteForm = document.getElementById('deleteForm');
            const teamNameDisplay = document.getElementById('teamNameDisplay');

            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const teamName = button.getAttribute('data-team-name');
                const teamSlug = button.getAttribute('data-team-slug');

                teamNameDisplay.textContent = teamName;
                deleteForm.action = '/teams/' + teamSlug + '/delete';
            });
        });
    </script>
}