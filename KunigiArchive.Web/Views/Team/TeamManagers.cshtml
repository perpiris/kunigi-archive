@model KunigiArchive.Web.ViewModels.Team.TeamManagersViewModel

@{
    ViewData["Title"] = $"Διαχείριση Διαχειριστών: {Model.TeamName}";
    ViewData["Banner"] = Model.TeamName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-controller="Team" asp-action="TeamActions" asp-route-slug="@Model.Slug" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Πίσω
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 mt-2 p-2">
            <div class="card-body p-4">
                <h5 class="mb-4">Προσθήκη Διαχειριστή</h5>

                @if (Model.AvailableUsers != null && Model.AvailableUsers.Count() > 1)
                {
                    <form asp-controller="Team" asp-action="AddTeamManager" asp-route-slug="@Model.Slug" method="post"
                          autocomplete="off" novalidate>
                        <div class="mb-3">
                            <label asp-for="SelectedUserId" class="form-label fw-semibold">Επιλογή χρήστη</label>
                            <div class="custom-select-wrapper" id="userWrapper">
                                <input type="text"
                                       class="form-control custom-select-display"
                                       id="userDisplay"
                                       placeholder="Επιλογή"
                                       readonly
                                       data-val="true"
                                       data-val-required="Το πεδίο απαιτείται."/>
                                <div class="custom-select-dropdown" id="userDropdown">
                                    <div class="custom-select-search">
                                        <input type="text"
                                               id="userSearch"
                                               placeholder="Αναζήτηση..."
                                               autocomplete="off"/>
                                    </div>
                                    <ul class="custom-select-options" id="userOptions"></ul>
                                </div>
                            </div>
                            <select asp-for="SelectedUserId" asp-items="@Model.AvailableUsers" id="userSelect"
                                    style="position:absolute;left:-9999px;width:1px;height:1px;" tabindex="-1"
                                    aria-hidden="true" required>
                                <option value="">Επιλέξτε χρήστη</option>
                            </select>
                            <span asp-validation-for="SelectedUserId" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary">Προσθήκη</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-muted text-center py-4 mb-3">
                        Δεν υπάρχουν διαθέσιμοι χρήστες για προσθήκη
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 mt-2 p-2">
            <div class="card-body p-4">
                <h5 class="mb-4">Τρέχοντες Διαχειριστές</h5>
                @if (Model.CurrentManagers.Any())
                {
                    <div class="manager-list">
                        @foreach (var manager in Model.CurrentManagers)
                        {
                            <div class="card border-light mb-3">
                                <div class="card-body py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold text-dark">@manager.Email</div>
                                        </div>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#confirmModal"
                                                data-user-id="@manager.AppUserId"
                                                data-user-email="@manager.Email">
                                            Αφαίρεση
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted text-center py-4">
                        Δεν υπάρχουν διαχειριστές αυτή τη στιγμή
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Επιβεβαίωση αφαίρεσης</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Είστε σίγουροι ότι θέλετε να αφαιρέσετε τον διαχειριστή <strong id="userEmail"></strong>;
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ακύρωση</button>
                <form asp-controller="Team" asp-action="RemoveTeamManager" asp-route-slug="@Model.Slug" method="post"
                      class="d-inline">
                    <input type="hidden" name="userId" id="userIdToRemove"/>
                    <button type="submit" class="btn btn-danger">Αφαίρεση</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initCustomSelect('user');

            const confirmModal = document.getElementById('confirmModal');
            if (confirmModal) {
                const userEmailSpan = document.getElementById('userEmail');
                const userIdInput = document.getElementById('userIdToRemove');

                confirmModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const userId = button.getAttribute('data-user-id');

                    userEmailSpan.textContent = button.getAttribute('data-user-email');
                    userIdInput.value = userId;
                });
            }
        });
    </script>
}