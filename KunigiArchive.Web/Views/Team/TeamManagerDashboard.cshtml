@model IEnumerable<KunigiArchive.Web.ViewModels.Team.TeamDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση";
}

<div class="mt-4">
    <div class="list-group">
        @foreach (var team in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span>@team.Name</span>
                </div>
                <a asp-controller="Team" asp-action="TeamActions" asp-route-slug="@team.Slug" class="btn btn-secondary">Ενέργειες</a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border border-2 border-dark">
            <h3 class="fw-bold text-uppercase">No Results Found</h3>
        </div>
    }
</div>