@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Team.TeamDetailsViewModel>

@{
    ViewData["Title"] = "Ομάδες";
    var searchQuery = ViewBag.SearchQuery ?? "";
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h1 class="display-4 mb-0">
            Οι Ομάδες
        </h1>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <form asp-controller="Team" asp-action="TeamList" method="get">
            <input type="hidden" name="pageNumber" value="1"/>
            <input type="hidden" name="pageSize" value="@Model.PageSize"/>

            <label class="form-label fw-bold text-uppercase small">Αναζήτησε μία ομάδα</label>
            <div class="input-group">
                <input type="text"
                       name="searchQuery"
                       value="@searchQuery"
                       class="form-control"
                       placeholder="όνομα ομάδας..."
                       aria-label="Search">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>

                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a asp-controller="Team" asp-action="TeamList" class="btn btn-danger" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<hr class="border-2 border-dark opacity-100 mb-5"/>

@if (Model.Items.Any())
{
    <div class="row g-2">
        @foreach (var team in Model.Items)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2-4">
                <div class="card h-100 border-2 border-dark">
                    <div class="card-header text-center bg-transparent border-bottom border-2 border-dark py-2">
                        <h6 class="fw-bold text-uppercase mb-0 small">@team.Name</h6>
                    </div>

                    <div class="position-relative overflow-hidden"
                         style="aspect-ratio: 1 / 1; background-color: #f5f5f5;">
                        @if (string.IsNullOrEmpty(team.Image))
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-image fs-1 opacity-25"></i>
                            </div>
                        }
                        else
                        {
                            <img src="~/@Url.Content(team.Image)"
                                 class="w-100 h-100"
                                 style="object-fit: cover; object-position: center;"
                                 alt="@team.Name">
                        }
                    </div>

                    <div class="card-body p-2 mt-2">
                        <a asp-controller="Team"
                           asp-action="TeamDetails"
                           asp-route-slug="@team.Slug"
                           class="btn btn-primary btn-sm w-100">
                            Προβολη
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="mt-5 pt-3 border-top border-2 border-dark">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center m-0">

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Team"
                           asp-action="TeamList"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchQuery="@searchQuery">
                            &lt;&lt;
                        </a>
                    </li>

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-controller="Team"
                               asp-action="TeamList"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchQuery="@searchQuery">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Team"
                           asp-action="TeamList"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchQuery="@searchQuery">
                            &gt;&gt;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
else
{
    <div class="text-center py-5 border border-2 border-dark">
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
        <a asp-controller="Team" asp-action="TeamList" class="btn btn-secondary mt-3">Καθαρισμός Φίλτρων</a>
    </div>
}