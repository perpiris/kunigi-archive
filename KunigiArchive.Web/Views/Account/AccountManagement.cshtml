@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Account.AccountDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση Χρηστών";
    var searchQuery = ViewBag.SearchQuery ?? "";
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h1 class="display-4 mb-2">
            Διαχείριση Χρηστών
        </h1>
        <a asp-controller="Account" asp-action="AccountCreate" class="btn btn-primary">Νέος Χρήστης</a>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <form asp-controller="Account" asp-action="AccountManagement" method="get">
            <input type="hidden" name="pageNumber" value="1"/>
            <input type="hidden" name="pageSize" value="@Model.PageSize"/>

            <label class="form-label fw-bold text-uppercase small">Αναζήτηση</label>
            <div class="input-group">
                <input type="text"
                       name="searchQuery"
                       value="@searchQuery"
                       class="form-control"
                       aria-label="Search">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>

                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a asp-controller="Account" asp-action="AccountManagement" class="btn btn-danger"
                       title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
            <tr>
                <th scope="col">Email Χρήστη</th>
                <th scope="col">Ρόλος</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Items)
            {
                <tr role="button"
                    onclick="window.location='@Url.Action("AccountDetails", "Account", new { id = user.AppUserId })'">
                    <td class="align-middle">@user.Email</td>
                    <td class="align-middle">
                        @if (!string.IsNullOrEmpty(user.Role))
                        {
                            <span class="badge bg-secondary">@user.Role</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5 border border-2 border-dark">
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
        <a asp-controller="Account" asp-action="AccountManagement" class="btn btn-secondary mt-3">Καθαρισμός Φίλτρων</a>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="mt-5 pt-3 border-top border-2 border-dark">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center m-0">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Account"
                       asp-action="AccountManagement"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &lt;&lt;
                    </a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Account"
                           asp-action="AccountManagement"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchQuery="@searchQuery">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Account"
                       asp-action="AccountManagement"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &gt;&gt;
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}