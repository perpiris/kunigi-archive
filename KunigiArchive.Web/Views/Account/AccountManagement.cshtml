@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Account.AccountDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση Χρηστών";
    var searchQuery = (string?)(ViewBag.SearchQuery ?? "");
    var pageNav = new KunigiArchive.Web.ViewModels.Common.PageNavViewModel
    {
        Controller = "Account",
        Action = "AccountManagement",
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        SearchQuery = searchQuery
    };
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h1 class="display-4 fw-bold mb-2">
            Διαχείριση Χρηστών
        </h1>
        <a asp-controller="Account" asp-action="AccountCreate" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Νέος Χρήστης
        </a>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <partial name="_SearchForm" model="pageNav"/>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
            <tr>
                <th scope="col">Email Χρήστη</th>
                <th scope="col">Ρόλος</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Items)
            {
                <tr role="button"
                    onclick="window.location='@Url.Action("AccountDetails", "Account", new { id = user.AppUserId })'">
                    <td class="align-middle">@user.Email</td>
                    <td class="align-middle">
                        @if (!string.IsNullOrEmpty(user.Role))
                        {
                            <span class="badge @(user.Role == "Admin" ? "bg-primary" : "bg-secondary")">@user.Role</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="pageNav"/>
}
else
{
    <div class="text-center py-5 border border-2 border-ink">
        <i class="bi bi-binoculars display-1 opacity-25 d-block mb-3"></i>
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <a asp-controller="Account" asp-action="AccountManagement" class="btn btn-secondary mt-3">Καθαρισμός Φίλτρων</a>
        }
    </div>
}
