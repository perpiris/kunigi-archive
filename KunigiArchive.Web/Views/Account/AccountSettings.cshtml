@model KunigiArchive.Web.ViewModels.Account.AccountSettingsViewModel

@{
    ViewData["Title"] = "Ρυθμίσεις Λογαριασμού";
    ViewData["Banner"] = "Ρυθμίσεις Λογαριασμού";

    var activeTab = ViewBag.ActiveTab ?? "email";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 p-2">
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-4">
                        <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist"
                             aria-orientation="vertical">
                            <button class="nav-link @(activeTab == "email" ? "active" : "") text-start"
                                    id="v-pills-email-tab" data-bs-toggle="pill"
                                    data-bs-target="#v-pills-email" type="button" role="tab"
                                    aria-controls="v-pills-email" aria-selected="true">Αλλαγή Email
                            </button>
                            <button class="nav-link @(activeTab == "password" ? "active" : "") text-start"
                                    id="v-pills-password-tab" data-bs-toggle="pill"
                                    data-bs-target="#v-pills-password" type="button" role="tab"
                                    aria-controls="v-pills-password" aria-selected="false">Αλλαγή Κωδικού
                            </button>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="tab-content" id="v-pills-tabContent">
                            <div class="tab-pane fade @(activeTab == "email" ? "show active" : "")" id="v-pills-email"
                                 role="tabpanel"
                                 aria-labelledby="v-pills-email-tab">
                                <form id="email-form" asp-controller="Account" asp-action="ChangeEmail" method="post">
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label fw-semibold"></label>
                                        <input asp-for="Email" class="form-control" autocomplete="email"
                                               aria-required="true"/>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="d-grid mt-4">
                                        <button id="update-email-button" type="submit" class="btn btn-primary">
                                            Αποθήκευση Email
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade @(activeTab == "password" ? "show active" : "")"
                                 id="v-pills-password" role="tabpanel"
                                 aria-labelledby="v-pills-password-tab">
                                <form id="password-form" asp-controller="Account" asp-action="ChangePassword"
                                      method="post">
                                    <div class="mb-3">
                                        <label asp-for="OldPassword" class="form-label fw-semibold"></label>
                                        <input asp-for="OldPassword" class="form-control" type="password"/>
                                        <span asp-validation-for="OldPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                                        <input asp-for="NewPassword" class="form-control" type="password"/>
                                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                                        <input asp-for="ConfirmNewPassword" class="form-control" type="password"/>
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="d-grid mt-4">
                                        <button id="update-password-button" type="submit" class="btn btn-primary">Αλλαγή
                                            Κωδικού
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}