@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Game.GameDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση Παιχνιδιών";
    ViewData["Banner"] = "Διαχείριση Παιχνιδιών";

    var searchTerm = ViewBag.SearchTerm ?? "";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-asp-controller="Game" asp-action="GameCreate" class="btn btn-primary">Νέο Παιχνίδι</a>
        @if (Model.Items.Any() || !string.IsNullOrEmpty(searchTerm))
        {
            <div class="d-flex gap-2">
                <form asp-controller="Game" asp-action="GameManagement" method="get" class="d-flex">
                    <input type="hidden" name="pageNumber" value="1"/>
                    <input type="hidden" name="pageSize" value="@Model.PageSize"/>
                    <div class="input-group" style="max-width: 300px;">
                        <input type="text" name="searchTerm" value="@searchTerm" class="form-control"
                               placeholder="Αναζήτηση"/>
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-controller="Game" asp-action="GameManagement" class="btn btn-secondary">Καθαρισμός</a>
                }
            </div>
        }
    </div>

    <div class="list-group">
        @foreach (var game in Model.Items)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div>
                        <span class="fw-semibold">@game.FormattedTitle()</span>
                    </div>
                </div>
                <a asp-controller="Game" asp-action="GameActions" asp-route-idOrYear="@game.Year"
                   class="btn btn-secondary">Ενέργειες</a>
            </div>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-center text-muted mt-4">Δεν βρέθηκαν αποτελέσματα.</p>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Game"
                       asp-action="GameManagement"
                       asp-route-pageNumber="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchTerm="@searchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}