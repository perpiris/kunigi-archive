@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Game.GameDetailsViewModel>

@{
    ViewData["Title"] = "Διαχείριση Παιχνιδιών";
    var searchQuery = ViewBag.SearchQuery ?? "";
}

<div class="row mb-5 align-items-end">
    <div class="col-lg-8">
        <h1 class="display-4 mb-2">
            Διαχείριση Παιχνιδιών
        </h1>
        <a asp-controller="Game" asp-action="GameCreate" class="btn btn-primary">Νέο Παιχνίδι</a>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <form asp-controller="Game" asp-action="GameManagement" method="get">
            <input type="hidden" name="pageNumber" value="1"/>
            <input type="hidden" name="pageSize" value="@Model.PageSize"/>

            <label class="form-label fw-bold text-uppercase small">Αναζήτησε ένα παιχνίδι</label>
            <div class="input-group">
                <input type="text"
                       name="searchQuery"
                       value="@searchQuery"
                       class="form-control"
                       placeholder="τίτλος, έτος..."
                       aria-label="Search">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>

                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a asp-controller="Game" asp-action="GameManagement" class="btn btn-danger" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
            <tr>
                <th scope="col">Τίτλος Παιχνιδιού</th>
                <th scope="col" class="text-end">Ενέργειες</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var game in Model.Items)
            {
                <tr>
                    <td class="align-middle">@game.FormattedTitle()</td>
                    <td class="text-end align-middle">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-controller="Game" asp-action="GameActions" asp-route-slug="@game.Slug"
                               class="btn btn-secondary btn-sm">Ενέργειες</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5 border border-2 border-dark">
        <h3 class="fw-bold text-uppercase">Δεν Βρέθηκαν Αποτελέσματα</h3>
        <a asp-controller="Game" asp-action="GameManagement" class="btn btn-secondary mt-3">Καθαρισμός Φίλτρων</a>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="mt-5 pt-3 border-top border-2 border-dark">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center m-0">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Game"
                       asp-action="GameManagement"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &lt;&lt;
                    </a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Game"
                           asp-action="GameManagement"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchQuery="@searchQuery">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Game"
                       asp-action="GameManagement"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchQuery="@searchQuery">
                        &gt;&gt;
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}