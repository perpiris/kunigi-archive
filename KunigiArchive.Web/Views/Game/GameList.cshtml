@model KunigiArchive.Web.ViewModels.Common.PaginatedViewModel<KunigiArchive.Web.ViewModels.Game.GameDetailsViewModel>

@{
    ViewData["Title"] = "Παιχνίδια";
    ViewData["Banner"] = "Όλα τα Παιχνίδια";

    var searchTerm = ViewBag.SearchTerm ?? "";
}

@if (Model.Items.Any() || !string.IsNullOrEmpty(searchTerm))
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <form asp-controller="Game" asp-action="GameList" method="get" class="d-flex flex-grow-1">
            <input type="hidden" name="pageNumber" value="1"/>
            <input type="hidden" name="pageSize" value="@Model.PageSize"/>
            <div class="input-group me-3" style="max-width: 400px;">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Αναζήτηση"/>
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <a asp-controller="Game" asp-action="GameList" class="btn btn-secondary">Καθαρισμός</a>
        }
    </div>
}

@if (Model.Items.Any())
{
    <div class="row g-4">
        @foreach (var game in Model.Items)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <a asp-controller="Game" asp-action="GameDetails" asp-route-year="@game.Year"
                   class="card h-100 text-decoration-none border-0"
                   style="transition: transform 0.2s; min-height: 400px;">
                    <div class="position-relative overflow-hidden rounded-top" style="height: 300px;">
                        @if (string.IsNullOrEmpty(game.Image))
                        {
                            <img src="~/images/profile.jpg" class="position-absolute top-50 start-50 translate-middle"
                                 style="max-width: 95%; max-height: 95%; width: auto; height: auto; object-fit: contain;"
                                 alt="Default Team Image">
                        }
                        else
                        {
                            <img src="~/@Url.Content(game.Image)"
                                 class="position-absolute top-50 start-50 translate-middle"
                                 style="max-width: 95%; max-height: 95%; width: auto; height: auto; object-fit: contain;"
                                 alt="@game.Title">
                        }
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 100px;">
                        <div class="text-center">
                            <h6 class="card-title mb-0 text-dark">
                                @game.FormattedTitle()
                            </h6>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Game"
                           asp-action="GameList"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@searchTerm">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <p class="text-center text-muted mt-4">Δεν βρέθηκαν αποτελέσματα.</p>
}