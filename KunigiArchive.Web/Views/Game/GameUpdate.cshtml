@model KunigiArchive.Web.ViewModels.Game.GameUpdateViewModel
@{
    ViewData["Title"] = "Επεξεργασία Παιχνιδιού";
    ViewData["Banner"] = "Επεξεργασία Παιχνιδιού";
    var isAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 mt-2">
            <div class="card-body p-4">
                <form asp-controller="Game" asp-action="GameUpdate" asp-route-slug="@Model.Slug" method="post"
                      autocomplete="off" enctype="multipart/form-data" id="update-game-form">
                    <input type="hidden" asp-for="GameId"/>
                    <input type="hidden" asp-for="Slug"/>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <input asp-for="Description" type="hidden"/>
                        <div id="editor-container" style="height: 400px;">@Html.Raw(Model.Description)</div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="accordion" id="gameAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#basicSettings" aria-expanded="true">
                                    Βασικές Ρυθμίσεις
                                </button>
                            </h2>
                            <div id="basicSettings" class="accordion-collapse collapse show"
                                 data-bs-parent="#gameAccordion">
                                <div class="accordion-body">
                                    @if (isAdmin)
                                    {
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="UpdatedSlug" class="form-label fw-semibold"></label>
                                                <input asp-for="UpdatedSlug" class="form-control"/>
                                                <span asp-validation-for="UpdatedSlug" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-3">
                                                <label asp-for="Year" class="form-label fw-semibold"></label>
                                                <input asp-for="Year" class="form-control"/>
                                                <span asp-validation-for="Year" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-3">
                                                <label asp-for="Order" class="form-label fw-semibold"></label>
                                                <input asp-for="Order" class="form-control"/>
                                                <span asp-validation-for="Order" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="HostId" class="form-label fw-semibold"></label>
                                                <div class="custom-select-wrapper" id="hostWrapper">
                                                    <input type="text"
                                                           class="form-control custom-select-display"
                                                           id="hostDisplay"
                                                           placeholder="Επιλογή"
                                                           readonly
                                                           data-val="true"
                                                           data-val-required="Το πεδίο απαιτείται."/>
                                                    <div class="custom-select-dropdown" id="hostDropdown">
                                                        <div class="custom-select-search">
                                                            <input type="text"
                                                                   id="hostSearch"
                                                                   placeholder="Αναζήτηση..."
                                                                   autocomplete="off"/>
                                                        </div>
                                                        <ul class="custom-select-options" id="hostOptions"></ul>
                                                    </div>
                                                </div>
                                                <select asp-for="HostId" asp-items="Model.HostSelectList"
                                                        id="hostSelect"
                                                        style="position:absolute;left:-9999px;width:1px;height:1px;"
                                                        tabindex="-1" aria-hidden="true">
                                                    <option value="">-- Επιλέξτε --</option>
                                                </select>
                                                <span asp-validation-for="HostId" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="WinnerId" class="form-label fw-semibold"></label>
                                                <div class="custom-select-wrapper" id="winnerWrapper">
                                                    <input type="text"
                                                           class="form-control custom-select-display"
                                                           id="winnerDisplay"
                                                           placeholder="Επιλογή"
                                                           readonly
                                                           data-val="true"
                                                           data-val-required="Το πεδίο απαιτείται."/>
                                                    <div class="custom-select-dropdown" id="winnerDropdown">
                                                        <div class="custom-select-search">
                                                            <input type="text"
                                                                   id="winnerSearch"
                                                                   placeholder="Αναζήτηση..."
                                                                   autocomplete="off"/>
                                                        </div>
                                                        <ul class="custom-select-options" id="winnerOptions"></ul>
                                                    </div>
                                                </div>
                                                <select asp-for="WinnerId" asp-items="Model.WinnerSelectList"
                                                        id="winnerSelect"
                                                        style="position:absolute;left:-9999px;width:1px;height:1px;"
                                                        tabindex="-1" aria-hidden="true">
                                                    <option value="">-- Επιλέξτε --</option>
                                                </select>
                                                <span asp-validation-for="WinnerId" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    }
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Image" class="form-label fw-semibold"></label>
                                            <input asp-for="Image" class="form-control" type="file"
                                                   accept="image/jpeg, image/png"/>
                                            <span asp-validation-for="Image" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Game" asp-action="GameActions" asp-route-slug="@Model.Slug"
                           class="btn btn-secondary">Πίσω</a>
                        <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css"/>
    <script src="~/lib/quill/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{'header': 1}, {'header': 2}],
                        [{'list': 'ordered'}, {'list': 'bullet'}],
                        [{'indent': '-1'}, {'indent': '+1'}],
                        [{'direction': 'rtl'}],
                        [{'size': ['small', false, 'large', 'huge']}],
                        [{'color': []}, {'background': []}],
                        [{'align': []}],
                        ['clean'],
                        ['link', 'image', 'video']
                    ]
                }
            });

            let form = document.querySelector('#update-game-form');
            let descriptionInput = form.querySelector('input[name="Description"]');

            form.addEventListener('submit', function () {
                let html = quill.root.innerHTML;
                descriptionInput.value = (html === '<p><br></p>') ? '' : html;
            });

            @if (isAdmin)
            {
                <text>
                    initCustomSelect('host');
                    initCustomSelect('winner');
                </text>
            }
        });
    </script>
}
