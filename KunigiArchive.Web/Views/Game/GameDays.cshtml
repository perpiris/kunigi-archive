@model KunigiArchive.Web.ViewModels.Game.GameDaysViewModel

@{
    ViewData["Title"] = $"{Model.FormattedTitle} - Διαχείριση Ημερών";
    ViewData["Banner"] = Model.FormattedTitle;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-controller="Game" asp-action="GameActions" asp-route-slug="@Model.Slug" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Επιστροφή στις Ενέργειες
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Διαχείριση Ημερών</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Game" asp-action="UpdateGameDays" asp-route-slug="@Model.Slug" method="post">
                    <div class="mb-4">
                        @for (var i = 0; i < Model.Days.Count; i++)
                        {
                            var day = Model.Days[i];
                            <div
                                class="d-flex justify-content-between align-items-center px-1 py-2 @(i < Model.Days.Count - 1 ? "border-bottom" : "")">
                                <span class="fw-bold">@day.Name</span>
                                <div>
                                    <input type="checkbox"
                                           class="btn-check"
                                           name="enabledDayIds"
                                           value="@day.GameDayId"
                                           id="day-@day.GameDayId"
                                           @(day.IsEnabled ? "checked" : "")
                                           autocomplete="off">
                                    <label class="btn btn-sm @(day.IsEnabled ? "btn-success" : "btn-outline-secondary")"
                                           for="day-@day.GameDayId"
                                           id="label-@day.GameDayId">
                                        @(day.IsEnabled ? "Ενεργή" : "Ανενεργή")
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-2"></i>Αποθήκευση
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-check').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var label = document.getElementById('label-' + this.id.replace('day-', ''));
                if (this.checked) {
                    label.textContent = 'Ενεργή';
                    label.classList.remove('btn-outline-secondary');
                    label.classList.add('btn-success');
                } else {
                    label.textContent = 'Ανενεργή';
                    label.classList.remove('btn-success');
                    label.classList.add('btn-outline-secondary');
                }
            });
        });
    </script>
}
