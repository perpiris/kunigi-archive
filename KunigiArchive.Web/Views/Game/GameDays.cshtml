@model KunigiArchive.Web.ViewModels.Game.GameDaysViewModel

@{
    ViewData["Title"] = $"{Model.FormattedTitle} - Διαχείριση Ημερών";
    ViewData["Banner"] = Model.FormattedTitle;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-controller="Game" asp-action="GameActions" asp-route-slug="@Model.Slug" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Επιστροφή στις Ενέργειες
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Διαχείριση Ημερών</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var day in Model.Days)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@day.Name</span>
                            <form asp-controller="Game" asp-action="ToggleGameDay"
                                  asp-route-slug="@Model.Slug"
                                  asp-route-gameDayId="@day.GameDayId"
                                  method="post">
                                <button type="submit"
                                        class="btn @(day.IsEnabled ? "btn-success" : "btn-outline-secondary") btn-sm"
                                        title="@(day.IsEnabled ? "Απενεργοποίηση" : "Ενεργοποίηση")">
                                    @(day.IsEnabled ? "Ενεργή" : "Ανενεργή")
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
