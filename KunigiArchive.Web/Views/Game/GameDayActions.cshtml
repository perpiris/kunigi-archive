@model KunigiArchive.Web.ViewModels.Game.GameDayActionsViewModel

@{
    ViewData["Title"] = $"{Model.GameDayName} - Ενέργειες";
    ViewData["Banner"] = Model.GameFormattedTitle;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-controller="Game" asp-action="GameActions" asp-route-slug="@Model.GameSlug" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Επιστροφή στις Ενέργειες
        </a>
    </div>
</div>

<h5 class="mb-4">@Model.GameDayName</h5>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-pencil display-4 mb-3"></i>
                <h5 class="card-title">Επεξεργασία</h5>
                <a asp-controller="Game" asp-action="GameDayUpdate"
                   asp-route-slug="@Model.GameSlug" asp-route-gameDayId="@Model.GameDayId"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-puzzle display-4 mb-3"></i>
                <h5 class="card-title">Γρίφοι</h5>
                <a asp-controller="Game" asp-action="ManagePuzzles"
                   asp-route-slug="@Model.GameSlug" asp-route-gameDayId="@Model.GameDayId"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-card-image display-4 mb-3"></i>
                <h5 class="card-title">Υλικό</h5>
                <a asp-controller="Game" asp-action="GameDayMedia"
                   asp-route-slug="@Model.GameSlug" asp-route-gameDayId="@Model.GameDayId"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>
