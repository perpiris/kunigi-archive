@model KunigiArchive.Web.ViewModels.Game.PuzzleManagementViewModel

@{
    ViewData["Title"] = $"{Model.GameDayName} - Γρίφοι";
    ViewData["Banner"] = Model.GameFormattedTitle;
}

@functions {

    static string GetThumbnailPath(string path)
    {
        var lastSlash = path.LastIndexOf('/');
        if (lastSlash < 0) return path;
        return $"{path[..(lastSlash + 1)]}thumb_{path[(lastSlash + 1)..]}";
    }

}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-controller="Game" asp-action="GameDayActions"
       asp-route-slug="@Model.GameSlug" asp-route-gameDayId="@Model.GameDayId"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Πίσω
    </a>
    <a asp-controller="Game" asp-action="CreatePuzzle"
       asp-route-slug="@Model.GameSlug" asp-route-gameDayId="@Model.GameDayId"
       class="btn btn-primary">
        Νέος Γρίφος
    </a>
</div>

<h5 class="mb-4">@Model.GameDayName</h5>

@if (Model.Puzzles.Any())
{
    <div class="accordion" id="puzzleAccordion">
        @foreach (var puzzle in Model.Puzzles)
        {
            var collapseId = $"collapse-{puzzle.PuzzleId}";
            var headingId = $"heading-{puzzle.PuzzleId}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                            aria-expanded="false" aria-controls="@collapseId">
                        <span class="fw-semibold">Γρίφος @puzzle.Order</span>
                        @if (puzzle.Group.HasValue)
                        {
                            <span class="badge bg-info ms-2">Πακέτο @puzzle.Group</span>
                        }
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse"
                     aria-labelledby="@headingId" data-bs-parent="#puzzleAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-2">Ερώτηση</h6>
                                <p class="text-break">@(puzzle.Question ?? "—")</p>
                                @if (puzzle.QuestionMedia.Any())
                                {
                                    <div class="row g-2 mt-2">
                                        @foreach (var media in puzzle.QuestionMedia)
                                        {
                                            <div class="col-4">
                                                <a href="/@media.Path" target="_blank">
                                                    <img src="/@GetThumbnailPath(media.Path)" class="img-fluid rounded"
                                                         alt="@media.FileName" loading="lazy"/>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-2">Απάντηση</h6>
                                <p class="text-break">@(puzzle.Answer ?? "—")</p>
                                @if (puzzle.AnswerMedia.Any())
                                {
                                    <div class="row g-2 mt-2">
                                        @foreach (var media in puzzle.AnswerMedia)
                                        {
                                            <div class="col-4">
                                                <a href="/@media.Path" target="_blank">
                                                    <img src="/@GetThumbnailPath(media.Path)" class="img-fluid rounded"
                                                         alt="@media.FileName" loading="lazy"/>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <hr/>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Game" asp-action="EditPuzzle"
                               asp-route-slug="@Model.GameSlug"
                               asp-route-gameDayId="@Model.GameDayId"
                               asp-route-puzzleId="@puzzle.PuzzleId"
                               class="btn btn-sm btn-primary">
                                Επεξεργασία
                            </a>
                            <button type="button" class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-puzzle-id="@puzzle.PuzzleId"
                                    data-puzzle-order="@puzzle.Order">
                                Διαγραφή
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 border border-2 border-ink">
        <h3 class="fw-bold text-uppercase">Δεν υπάρχουν γρίφοι</h3>
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Επιβεβαίωση διαγραφής</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Είστε σίγουροι ότι θέλετε να διαγράψετε τον <strong id="puzzleOrderText"></strong>;
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ακύρωση</button>
                <form id="deleteForm" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">Διαγραφή</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const puzzleId = button.getAttribute('data-puzzle-id');
                    const puzzleOrder = button.getAttribute('data-puzzle-order');

                    document.getElementById('puzzleOrderText').textContent = 'Γρίφο ' + puzzleOrder;
                    document.getElementById('deleteForm').action =
                        '@Url.Action("DeletePuzzle", "Game", new { slug = Model.GameSlug, gameDayId = Model.GameDayId, puzzleId = "__ID__" })'.replace('__ID__', puzzleId);
                });
            }
        });
    </script>
}
