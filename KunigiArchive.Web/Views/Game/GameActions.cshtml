@model KunigiArchive.Web.ViewModels.Game.GameDetailsViewModel;

@{
    ViewData["Title"] = $"{Model.FormattedTitle()} - Ενέργειες";
    ViewData["Banner"] = Model.FormattedTitle();

    var columnClass = "col-md-3";
}

<div class="row g-4">
    <div class="@columnClass">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-eye-fill display-4 mb-3"></i>
                <h5 class="card-title">Προβολή</h5>
                <a asp-controller="Game" asp-action="GameDetails" asp-route-slug="@Model.Slug"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="@columnClass">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-pencil display-4 mb-3"></i>
                <h5 class="card-title">Επεξεργασία</h5>
                <a asp-controller="Game" asp-action="GameUpdate" asp-route-slug="@Model.Slug"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="@columnClass">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-card-image display-4 mb-3"></i>
                <h5 class="card-title">Υλικό</h5>
                <a asp-controller="Game" asp-action="GameMedia" asp-route-slug="@Model.Slug"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>

    <div class="@columnClass">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-calendar3 display-4 mb-3"></i>
                <h5 class="card-title">Ημέρες</h5>
                <a asp-controller="Game" asp-action="GameDays" asp-route-slug="@Model.Slug"
                   class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>

@if (Model.GameDays.Count > 0)
{
    <h5 class="mt-5 mb-3">Ημέρες Παιχνιδιού</h5>
    <div class="row g-4">
        @foreach (var day in Model.GameDays)
        {
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-calendar-event display-4 mb-3"></i>
                        <h5 class="card-title">@day.Name</h5>
                        <a asp-controller="Game" asp-action="GameDayActions"
                           asp-route-slug="@Model.Slug" asp-route-gameDayId="@day.GameDayId"
                           class="stretched-link"></a>
                    </div>
                </div>
            </div>
        }
    </div>
}
