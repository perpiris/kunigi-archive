@model List<KunigiArchive.Web.ViewModels.Common.MediaFileViewModel>

<link rel="stylesheet" href="~/lib/fancybox/fancybox.css"/>

<div class="media-gallery">
    @foreach (var item in Model)
    {
        var mediaType = GetMediaType(item.FileName);
        var mediaPath = Url.Content($"~/{item.Path}");

        @if (mediaType == "image")
        {
            <a href="@mediaPath"
               data-fancybox="gallery"
               class="media-item">
                <div class="media-thumbnail">
                    <img src="@mediaPath" alt="@item.FileName"/>
                </div>
            </a>
        }
        else if (mediaType == "video")
        {
            <a href="@mediaPath"
               data-fancybox="gallery"
               class="media-item">
                <div class="media-thumbnail video-thumb">
                    <video preload="metadata" muted>
                        <source src="@mediaPath" type="video/mp4">
                    </video>
                    <div class="play-overlay">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>
                </div>
            </a>
        }
    }
</div>

<style>
    .media-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        padding: 0;
    }

    .media-item {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: 8px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
    }

    .media-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .media-thumbnail {
        position: relative;
        width: 100%;
        height: 200px;
        background-color: #f8f9fa;
        overflow: hidden;
    }

    .media-thumbnail img,
    .media-thumbnail video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .video-thumb {
        position: relative;
    }

    .play-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.3);
        transition: background-color 0.3s ease;
    }

    .media-item:hover .play-overlay {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .play-overlay i {
        font-size: 3rem;
        color: white;
        opacity: 0.9;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .media-item:hover .play-overlay i {
        transform: scale(1.1);
        opacity: 1;
    }

    @@media (max-width: 768px) {
        .media-gallery {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 12px;
        }

        .media-thumbnail {
            height: 150px;
        }

        .play-overlay i {
            font-size: 2.5rem;
        }
    }

    @@media (max-width: 576px) {
        .media-gallery {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .media-thumbnail {
            height: 120px;
        }

        .play-overlay i {
            font-size: 2rem;
        }
    }
</style>

<script src="~/lib/fancybox/fancybox.umd.js"></script>

<script>
    Fancybox.bind("[data-fancybox='gallery']", {
        Carousel: {
            Thumbs: false,
        },
    });
</script>

@functions {

    static string GetMediaType(string fileName)
    {
        var extension = fileName[(fileName.LastIndexOf('.') + 1)..].ToLowerInvariant();
        return extension switch
        {
            "jpg" or "jpeg" or "png" or "gif" or "bmp" or "svg" or "webp" => "image",
            "mp4" or "avi" or "mov" or "wmv" or "webm" => "video",
            _ => "unknown"
        };
    }

}