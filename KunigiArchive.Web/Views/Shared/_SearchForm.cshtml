@model KunigiArchive.Web.ViewModels.Common.PageNavViewModel

<form asp-controller="@Model.Controller" asp-action="@Model.Action" method="get">
    <input type="hidden" name="pageNumber" value="1"/>
    <input type="hidden" name="pageSize" value="@Model.PageSize"/>

    <label class="form-label fw-bold text-uppercase small">Αναζήτηση</label>
    <div class="input-group">
        <input type="text"
               name="searchQuery"
               value="@Model.SearchQuery"
               class="form-control"
               aria-label="Αναζήτηση">

        <button type="submit" class="btn btn-primary" aria-label="Αναζήτηση">
            <i class="bi bi-search"></i>
        </button>

        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a asp-controller="@Model.Controller" asp-action="@Model.Action" class="btn btn-danger"
               title="Καθαρισμός αναζήτησης">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>
