@model KunigiArchive.Web.ViewModels.Game.PuzzleDetailsViewModel

<div class="row g-0">
    <div class="col-md-6 pe-md-4 @(Model.AnswerMedia.Any() || !string.IsNullOrEmpty(Model.Answer) ? "border-end border-2 border-ink" : "")">
        <h6 class="fw-bold text-uppercase text-muted mb-2">Ερώτηση</h6>
        @if (!string.IsNullOrEmpty(Model.Question))
        {
            <div class="mb-3">
                @Html.Raw(Model.Question)
            </div>
        }

        @if (Model.QuestionMedia.Any())
        {
            <div class="puzzle-media-grid @(Model.QuestionMedia.Count == 1 ? "single-item" : "")">
                @foreach (var media in Model.QuestionMedia)
                {
                    var mediaType = GetMediaType(media.FileName);
                    var mediaPath = Url.Content($"~/{media.Path}");

                    <div class="puzzle-media-item">
                        @if (mediaType == "image")
                        {
                            <a href="@mediaPath" data-fancybox="puzzle-@Model.PuzzleId-q">
                                <img src="@mediaPath" alt="@media.FileName"/>
                            </a>
                        }
                        else if (mediaType == "video")
                        {
                            <a href="@mediaPath" data-fancybox="puzzle-@Model.PuzzleId-q">
                                <div class="video-wrapper">
                                    <video preload="metadata" muted>
                                        <source src="@mediaPath" type="video/mp4">
                                    </video>
                                    <div class="play-icon">
                                        <i class="bi bi-play-circle-fill"></i>
                                    </div>
                                </div>
                            </a>
                        }
                        else if (mediaType == "audio")
                        {
                            <div class="audio-wrapper">
                                <audio controls preload="metadata">
                                    <source src="@mediaPath">
                                </audio>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-md-6 ps-md-4">
        <h6 class="fw-bold text-uppercase text-muted mb-2">Απάντηση</h6>
        @if (!string.IsNullOrEmpty(Model.Answer))
        {
            <div class="mb-3">
                @Html.Raw(Model.Answer)
            </div>
        }

        @if (Model.AnswerMedia.Any())
        {
            <div class="puzzle-media-grid @(Model.AnswerMedia.Count == 1 ? "single-item" : "")">
                @foreach (var media in Model.AnswerMedia)
                {
                    var mediaType = GetMediaType(media.FileName);
                    var mediaPath = Url.Content($"~/{media.Path}");

                    <div class="puzzle-media-item">
                        @if (mediaType == "image")
                        {
                            <a href="@mediaPath" data-fancybox="puzzle-@Model.PuzzleId-a">
                                <img src="@mediaPath" alt="@media.FileName"/>
                            </a>
                        }
                        else if (mediaType == "video")
                        {
                            <a href="@mediaPath" data-fancybox="puzzle-@Model.PuzzleId-a">
                                <div class="video-wrapper">
                                    <video preload="metadata" muted>
                                        <source src="@mediaPath" type="video/mp4">
                                    </video>
                                    <div class="play-icon">
                                        <i class="bi bi-play-circle-fill"></i>
                                    </div>
                                </div>
                            </a>
                        }
                        else if (mediaType == "audio")
                        {
                            <div class="audio-wrapper">
                                <audio controls preload="metadata">
                                    <source src="@mediaPath">
                                </audio>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@functions {

    static string GetMediaType(string fileName)
    {
        var extension = fileName[(fileName.LastIndexOf('.') + 1)..].ToLowerInvariant();
        return extension switch
        {
            "jpg" or "jpeg" or "png" or "gif" or "bmp" or "svg" or "webp" => "image",
            "mp4" or "avi" or "mov" or "wmv" or "webm" => "video",
            "mp3" or "wav" or "ogg" or "flac" or "aac" => "audio",
            _ => "unknown"
        };
    }

}
